# dengo-admin — en el servidor va en ~/dengo/admin/.env y el proceso arranca con cwd ahí.

# real = ejecuta de verdad · simulate = registra los comandos sin ejecutarlos (desarrollo en Windows)
ADMIN_MODE=real
PORT=4900
HOST=127.0.0.1

# npm run hash-password -- 'tu-clave'   → pega el resultado aquí
ADMIN_PASSWORD_HASH=
# openssl rand -hex 32
SESSION_SECRET=

# Raíz de DENGO en el servidor (app/, clients/, backups/, caddy/, admin/)
DENGO_ROOT=/home/deploy/dengo
# Carpeta del frontend compilado que Caddy sirve para todos los POS
FRONTEND_DIST=/home/deploy/dengo/app/dengo-frontend/dist
# IP pública del servidor: se compara con el DNS de cada dominio antes de tocar Caddy
SERVER_IP=

# PostgreSQL: un rol con permiso CREATEDB para crear bases de clientes nuevos…
PG_ADMIN_URL=postgresql://postgres:clave@localhost:5432/postgres
# …y el usuario dueño de las bases de los clientes (va dentro de cada DATABASE_URL)
DB_APP_USER=dengo
DB_APP_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Globales compartidos por todos los clientes
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_ANALYST_MODEL=claude-sonnet-5-5
DIGIFACT_USER=
DIGIFACT_PASSWORD=
