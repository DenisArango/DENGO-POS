{
  "name": "dengo-admin",
  "private": true,
  "version": "1.0.0",
  "description": "Consola del proveedor: alta y administración de clientes de DENGO POS",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web \"tsx watch server/index.ts\" \"vite\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsup server/index.ts --format esm --out-dir dist --clean=false",
    "start": "node dist/index.js",
    "test": "tsx --test \"server/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "hash-password": "tsx server/scripts/hash-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "@fastify/static": "^10.1.12",
    "adm-zip": "^0.6.1",
    "bcryptjs": "^3.0.3",
    "fastify": "^5.12.8",
    "pg": "^8.23.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@types/adm-zip": "^0.5.8",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.20.7",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.2",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "concurrently": "^10.0.7",
    "lucide-react": "^1.80.0",
    "motion": "^14.14.0",
    "postcss": "^8.5.33",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "sonner": "^2.0.8",
    "tailwindcss": "^3.4.19",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "~5.8",
    "vite": "^6.4.6"
  }
}
