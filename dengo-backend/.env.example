# DENGO POS — Backend environment variables
# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Hosted options: self-hosted on the same VPS as the app, or a managed provider
# (Neon, Supabase, Railway) — see the "Implementación y Negocio" docs.
DATABASE_URL=

# Secret used to sign JWTs. Use a long random string (openssl rand -hex 32).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call the API (no trailing slash).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Requests per window before the global rate limiter returns 429.
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# Optional — enables AI-powered report chat (/api/ai/query-report) and
# recommendations (/api/ai/analyze). Without it, both fall back to
# keyword matching / rule-based recommendations, no external calls made.
# Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Secret only you (the vendor) know — lets PUT /api/license toggle which
# modules (página/maestros/pos) this client's install has paid for. Never
# put this in a frontend or share it with the client. See Implementación y
# Negocio → docs for how this fits the "un proceso por cliente" model.
LICENSE_ADMIN_SECRET=

PORT=3001
HOST=0.0.0.0
NODE_ENV=development
