# DENGO POS — Backend environment variables
# Copy to .env and fill in real values. Never commit the real .env file.

# PostgreSQL connection string used by Prisma.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Hosted options: self-hosted on the same VPS as the app, or a managed provider
# (Neon, Supabase, Railway) — see the "Implementación y Negocio" docs.
DATABASE_URL=

# Secret used to sign JWTs. Use a long random string (openssl rand -hex 32).
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Comma-separated list of origins allowed to call the API (no trailing slash).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# Requests per window before the global rate limiter returns 429.
RATE_LIMIT_MAX=200
RATE_LIMIT_WINDOW_MS=60000

# Optional — enables AI-powered report chat (/api/ai/query-report) and
# recommendations (/api/ai/analyze). Without it, both fall back to
# keyword matching / rule-based recommendations, no external calls made.
# Get a key at console.anthropic.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# Model for the data analyst (/api/ai/analyst). Optional; default claude-sonnet-5-5.
ANTHROPIC_ANALYST_MODEL=claude-sonnet-5-5

# Secret only you (the vendor) know — lets PUT /api/license toggle which
# modules (página/maestros/pos) this client's install has paid for. Never
# put this in a frontend or share it with the client. See Implementación y
# Negocio → docs for how this fits the "un proceso por cliente" model.
LICENSE_ADMIN_SECRET=

PORT=3001
HOST=0.0.0.0
NODE_ENV=development

# ── Facturación electrónica (FEL Guatemala) — ver docs/fel/README.md ──
# none = no se envía nada (facturas quedan pendientes) · mock = simulador sin validez fiscal · felplex = certificador real
FEL_PROVIDER=none
# stage (pruebas, gratis) | production
FELPLEX_ENV=stage
# "ID de empresa" que da FELplex (uno por establecimiento SAT; las sucursales pueden tener el suyo en Tiendas)
FELPLEX_ENTITY_ID=
FELPLEX_API_KEY=
# Opcional, si cada establecimiento tiene su propia API Key: {"<entityId>":"<apiKey>"}
FELPLEX_API_KEYS=
# FACT = contribuyente general (IVA 12 %) · FPEQ / FAPE = pequeño contribuyente
FEL_DOC_TYPE=FACT
FEL_IVA_RATE=0.12
# Facturar a "Consumidor Final" sin NIT (la SAT pide NIT o CUI desde FEL_CF_MAX_TOTAL)
FEL_ALLOW_CF=false
FEL_CF_MAX_TOTAL=2500
# El certificador envía el PDF al correo del cliente
FEL_SEND_EMAIL=false
FEL_TIMEOUT_MS=30000
FEL_RETRY_MINUTES=5
FEL_MAX_ATTEMPTS=5
