// DENGO POS – Prisma Schema (SQL Server)
// Run: npx prisma generate       (after any schema change)
// Run: npx prisma db push        (sync schema to DB, first time)
//
// NOTE: SQL Server does not support Prisma enums — values are stored as String.
// Validation is enforced by the service layer and CHECK constraints in the DB.
// NOTE: SQL Server forbids multiple cascade paths. All relations use NoAction;
// cascade deletes are handled explicitly in the service layer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlserver"
  url      = env("DATABASE_URL")
}

// ── Models ─────────────────────────────────────────────────────────────────

model Branch {
  id             String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  name           String   @map("NAME") @db.NVarChar(150)
  code           String   @unique @map("CODE") @db.NVarChar(20)
  type           String   @default("branch") @map("TYPE") @db.NVarChar(20)
  address        String   @default("") @map("ADDRESS") @db.NVarChar(255)
  city           String   @default("") @map("CITY") @db.NVarChar(100)
  phone          String   @default("") @map("PHONE") @db.NVarChar(30)
  email          String   @default("") @map("EMAIL") @db.NVarChar(150)
  manager        String   @default("") @map("MANAGER") @db.NVarChar(150)
  status         String   @default("active") @map("STATUS") @db.NVarChar(20)
  openTime       String   @default("08:00") @map("OPEN_TIME") @db.NVarChar(5)
  closeTime      String   @default("20:00") @map("CLOSE_TIME") @db.NVarChar(5)
  currency       String   @default("GTQ") @map("CURRENCY") @db.NVarChar(10)
  timezone       String   @default("America/Guatemala") @map("TIMEZONE") @db.NVarChar(60)
  taxRate        Decimal  @default(0.12) @map("TAX_RATE") @db.Decimal(5, 4)
  printerEnabled Boolean  @default(true) @map("PRINTER_ENABLED")
  // Company / branding per branch
  logo           String?  @map("LOGO") @db.NVarChar(Max)
  companyName    String?  @map("COMPANY_NAME") @db.NVarChar(150)
  companyTaxId   String?  @map("COMPANY_TAX_ID") @db.NVarChar(30)
  companyTagline String?  @map("COMPANY_TAGLINE") @db.NVarChar(200)
  companyWebsite String?  @map("COMPANY_WEBSITE") @db.NVarChar(150)
  createdAt      DateTime @default(now()) @map("CREATED_AT")
  updatedAt      DateTime @updatedAt @map("UPDATED_AT")

  users          User[]
  inventory      Inventory[]
  sales          Sale[]
  cashRegisters  CashRegister[]
  purchaseOrders PurchaseOrder[]
  transfersFrom  Transfer[]      @relation("FromBranch")
  transfersTo    Transfer[]      @relation("ToBranch")
  quotations     Quotation[]
  stockMovements StockMovement[]

  @@map("BRANCHES")
}

model User {
  id           String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  email        String   @unique @map("EMAIL") @db.NVarChar(150)
  name         String   @map("NAME") @db.NVarChar(150)
  passwordHash String   @map("PASSWORD_HASH") @db.NVarChar(255)
  role         String   @map("ROLE") @db.NVarChar(30)   // ADMIN | AUDITOR | INVENTORY_CONTROL | OPERATOR
  branchId     String   @map("BRANCH_ID") @db.NVarChar(36)
  isActive     Boolean  @default(true) @map("IS_ACTIVE")
  createdAt    DateTime @default(now()) @map("CREATED_AT")
  updatedAt    DateTime @updatedAt @map("UPDATED_AT")

  branch              Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sales               Sale[]          @relation("CashierSales")
  voidedSales         Sale[]          @relation("VoidedSales")
  cashRegistersOpened CashRegister[]  @relation("OpenedBy")
  cashRegistersClosed CashRegister[]  @relation("ClosedBy")
  cashMovements       CashMovement[]
  purchaseOrders      PurchaseOrder[] @relation("CreatedBy")
  receivedOrders      PurchaseOrder[] @relation("ReceivedBy")
  requestedTransfers  Transfer[]      @relation("RequestedBy")
  approvedTransfers   Transfer[]      @relation("ApprovedBy")
  receivedTransfers   Transfer[]      @relation("ReceivedByUser")
  quotations          Quotation[]
  stockMovements      StockMovement[]
  auditLogs           AuditLog[]
  loginHistory        LoginHistory[]
  priceHistory        PriceHistory[]
  creditPayments      CreditPayment[]
  teacher              Teacher?
  approvedPortalOrders    PortalOrder[]             @relation("ApprovedPortalOrders")
  purchaseTrackingUpdates PortalPurchaseTracking[]  @relation("UpdatedByUser")
  sentMessages            InternalMessage[]         @relation("SentMessages")
  receivedMessages        InternalMessage[]         @relation("ReceivedMessages")

  @@map("USERS")
}

model Category {
  id          String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  name        String    @map("NAME") @db.NVarChar(100)
  description String?   @map("DESCRIPTION") @db.NVarChar(500)
  color       String?   @map("COLOR") @db.NVarChar(30)
  isActive    Boolean   @default(true) @map("IS_ACTIVE")
  createdAt   DateTime  @default(now()) @map("CREATED_AT")
  updatedAt   DateTime  @updatedAt @map("UPDATED_AT")

  products Product[]

  @@map("CATEGORIES")
}

model ProductUnit {
  id           String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  name         String   @map("NAME") @db.NVarChar(60)
  abbreviation String   @map("ABBREVIATION") @db.NVarChar(10)
  type         String   @map("TYPE") @db.NVarChar(20)  // DISCRETE | CONTINUOUS
  createdAt    DateTime @default(now()) @map("CREATED_AT")

  products Product[]

  @@map("PRODUCT_UNITS")
}

model ProductBarcode {
  id          String  @id @default(cuid()) @map("ID") @db.NVarChar(36)
  productId   String  @map("PRODUCT_ID") @db.NVarChar(36)
  barcode     String  @unique @map("BARCODE") @db.NVarChar(50)
  description String? @map("DESCRIPTION") @db.NVarChar(100)

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PRODUCT_BARCODES")
}

model Product {
  id          String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  barcode     String?  @unique @map("BARCODE") @db.NVarChar(50)
  sku         String?  @map("SKU") @db.NVarChar(50)
  name        String   @map("NAME") @db.NVarChar(200)
  brand       String?  @map("BRAND") @db.NVarChar(100)
  description String?  @map("DESCRIPTION") @db.NVarChar(Max)
  basePrice   Decimal  @default(0) @map("BASE_PRICE") @db.Decimal(18, 2)
  cost        Decimal  @default(0) @map("COST") @db.Decimal(18, 2)
  imageUrl    String?  @map("IMAGE_URL") @db.NVarChar(500)
  categoryId  String   @map("CATEGORY_ID") @db.NVarChar(36)
  baseUnitId  String   @map("BASE_UNIT_ID") @db.NVarChar(36)
  minStock    Int      @default(0) @map("MIN_STOCK")
  salesCount  Int      @default(0) @map("SALES_COUNT")
  isActive    Boolean  @default(true) @map("IS_ACTIVE")
  createdAt   DateTime @default(now()) @map("CREATED_AT")
  updatedAt   DateTime @updatedAt @map("UPDATED_AT")

  category       Category            @relation(fields: [categoryId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  baseUnit       ProductUnit         @relation(fields: [baseUnitId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variations     ProductVariation[]
  attributes     ProductAttribute[]
  altBarcodes    ProductBarcode[]
  inventory      Inventory[]
  stockMovements StockMovement[]
  saleItems      SaleItem[]
  purchaseItems  PurchaseOrderItem[]
  transferItems  TransferItem[]
  quotationItems QuotationItem[]
  priceHistory   PriceHistory[]
  portalOrderItems    PortalOrderItem[]
  programOptionItems  ProgramOptionItem[]
  purchaseTracking    PortalPurchaseTracking[]

  @@map("PRODUCTS")
}

model ProductVariation {
  id               String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  productId        String   @map("PRODUCT_ID") @db.NVarChar(36)
  name             String   @map("NAME") @db.NVarChar(100)
  barcode          String?  @map("BARCODE") @db.NVarChar(50)
  conversionFactor Decimal  @default(1) @map("CONVERSION_FACTOR") @db.Decimal(18, 4)
  price            Decimal  @map("PRICE") @db.Decimal(18, 2)
  isDefault        Boolean  @default(false) @map("IS_DEFAULT")
  createdAt        DateTime @default(now()) @map("CREATED_AT")

  product        Product         @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  saleItems      SaleItem[]
  quotationItems QuotationItem[]

  @@map("PRODUCT_VARIATIONS")
}

model ProductAttribute {
  id        String @id @default(cuid()) @map("ID") @db.NVarChar(36)
  productId String @map("PRODUCT_ID") @db.NVarChar(36)
  attrName  String @map("ATTR_NAME") @db.NVarChar(100)
  attrValue String @map("ATTR_VALUE") @db.NVarChar(255)

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PRODUCT_ATTRIBUTES")
}

model Inventory {
  id            String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  productId     String    @map("PRODUCT_ID") @db.NVarChar(36)
  branchId      String    @map("BRANCH_ID") @db.NVarChar(36)
  quantity      Decimal   @default(0) @map("QUANTITY") @db.Decimal(18, 4)
  lastRestockAt DateTime? @map("LAST_RESTOCK_AT")
  lastSaleAt    DateTime? @map("LAST_SALE_AT")
  updatedAt     DateTime  @updatedAt @map("UPDATED_AT")

  product Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, branchId])
  @@map("INVENTORY")
}

model StockMovement {
  id             String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  productId      String   @map("PRODUCT_ID") @db.NVarChar(36)
  branchId       String   @map("BRANCH_ID") @db.NVarChar(36)
  type           String   @map("TYPE") @db.NVarChar(20)  // IN | OUT | ADJUSTMENT | TRANSFER | SALE | RETURN
  quantity       Decimal  @map("QUANTITY") @db.Decimal(18, 4)
  quantityBefore Decimal? @map("QUANTITY_BEFORE") @db.Decimal(18, 4)
  quantityAfter  Decimal? @map("QUANTITY_AFTER") @db.Decimal(18, 4)
  reason         String?  @map("REASON") @db.NVarChar(500)
  referenceId    String?  @map("REFERENCE_ID") @db.NVarChar(36)
  performedById  String   @map("PERFORMED_BY_ID") @db.NVarChar(36)
  createdAt      DateTime @default(now()) @map("CREATED_AT")

  product     Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch      Branch  @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  performedBy User    @relation(fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("STOCK_MOVEMENTS")
}

model Customer {
  id          String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  nit         String    @unique @map("NIT") @db.NVarChar(30)
  name        String    @map("NAME") @db.NVarChar(150)
  email       String?   @map("EMAIL") @db.NVarChar(150)
  phone       String?   @map("PHONE") @db.NVarChar(30)
  address     String?   @map("ADDRESS") @db.NVarChar(300)
  creditLimit Decimal   @default(0) @map("CREDIT_LIMIT") @db.Decimal(18, 2)
  creditUsed  Decimal   @default(0) @map("CREDIT_USED") @db.Decimal(18, 2)
  isActive    Boolean   @default(true) @map("IS_ACTIVE")
  createdAt   DateTime  @default(now()) @map("CREATED_AT")
  updatedAt   DateTime  @updatedAt @map("UPDATED_AT")

  sales      Sale[]
  quotations Quotation[]

  @@map("CUSTOMERS")
}

model Supplier {
  id           String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  code         String   @unique @map("CODE") @db.NVarChar(30)
  name         String   @map("NAME") @db.NVarChar(150)
  contactName  String   @default("") @map("CONTACT_NAME") @db.NVarChar(150)
  email        String?  @map("EMAIL") @db.NVarChar(150)
  phone        String?  @map("PHONE") @db.NVarChar(30)
  address      String?  @map("ADDRESS") @db.NVarChar(300)
  city         String?  @map("CITY") @db.NVarChar(100)
  taxId        String?  @map("TAX_ID") @db.NVarChar(30)
  paymentTerms String   @default("Contado") @map("PAYMENT_TERMS") @db.NVarChar(50)
  creditLimit  Decimal? @map("CREDIT_LIMIT") @db.Decimal(18, 2)
  notes        String?  @map("NOTES") @db.NVarChar(Max)
  isActive     Boolean  @default(true) @map("IS_ACTIVE")
  rating       Int?     @map("RATING")
  createdAt    DateTime @default(now()) @map("CREATED_AT")
  updatedAt    DateTime @updatedAt @map("UPDATED_AT")

  purchaseOrders PurchaseOrder[]

  @@map("SUPPLIERS")
}

model CashRegister {
  id             String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  branchId       String   @map("BRANCH_ID") @db.NVarChar(36)
  name           String   @default("Caja") @map("NAME") @db.NVarChar(60)
  registerNumber String   @default("1") @map("REGISTER_NUMBER") @db.NVarChar(20)
  openedById     String   @map("OPENED_BY_ID") @db.NVarChar(36)
  closedById     String?  @map("CLOSED_BY_ID") @db.NVarChar(36)
  openedAt       DateTime @default(now()) @map("OPENED_AT")
  closedAt       DateTime? @map("CLOSED_AT")
  initialAmount  Decimal  @map("INITIAL_AMOUNT") @db.Decimal(18, 2)
  finalAmount    Decimal? @map("FINAL_AMOUNT") @db.Decimal(18, 2)
  expectedAmount Decimal? @map("EXPECTED_AMOUNT") @db.Decimal(18, 2)
  difference     Decimal? @map("DIFFERENCE") @db.Decimal(18, 2)
  status         String   @default("OPEN") @map("STATUS") @db.NVarChar(10)  // OPEN | CLOSED
  totalSales     Decimal  @default(0) @map("TOTAL_SALES") @db.Decimal(18, 2)
  salesCount     Int      @default(0) @map("SALES_COUNT")
  cashSales      Decimal  @default(0) @map("CASH_SALES") @db.Decimal(18, 2)
  cardSales      Decimal  @default(0) @map("CARD_SALES") @db.Decimal(18, 2)
  transferSales  Decimal  @default(0) @map("TRANSFER_SALES") @db.Decimal(18, 2)
  createdAt      DateTime @default(now()) @map("CREATED_AT")
  updatedAt      DateTime @updatedAt @map("UPDATED_AT")

  branch    Branch         @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  openedBy  User           @relation("OpenedBy", fields: [openedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  closedBy  User?          @relation("ClosedBy", fields: [closedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  movements CashMovement[]
  sales     Sale[]

  @@map("CASH_REGISTERS")
}

model CashMovement {
  id             String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  cashRegisterId String   @map("CASH_REGISTER_ID") @db.NVarChar(36)
  type           String   @map("TYPE") @db.NVarChar(10)  // INCOME | EXPENSE
  amount         Decimal  @map("AMOUNT") @db.Decimal(18, 2)
  description    String   @map("DESCRIPTION") @db.NVarChar(500)
  performedById  String   @map("PERFORMED_BY_ID") @db.NVarChar(36)
  createdAt      DateTime @default(now()) @map("CREATED_AT")

  cashRegister CashRegister @relation(fields: [cashRegisterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  performedBy  User         @relation(fields: [performedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("CASH_MOVEMENTS")
}

model Sale {
  id             String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  invoiceNumber  String    @unique @map("INVOICE_NUMBER") @db.NVarChar(50)
  branchId       String    @map("BRANCH_ID") @db.NVarChar(36)
  cashierId      String    @map("CASHIER_ID") @db.NVarChar(36)
  customerId     String?   @map("CUSTOMER_ID") @db.NVarChar(36)
  cashRegisterId String?   @map("CASH_REGISTER_ID") @db.NVarChar(36)
  subtotal       Decimal   @map("SUBTOTAL") @db.Decimal(18, 2)
  tax            Decimal   @default(0) @map("TAX") @db.Decimal(18, 2)
  discount       Decimal   @default(0) @map("DISCOUNT") @db.Decimal(18, 2)
  total          Decimal   @map("TOTAL") @db.Decimal(18, 2)
  paymentMethod          String    @map("PAYMENT_METHOD") @db.NVarChar(20)  // CASH | CARD | TRANSFER | MIXED | CREDIT
  saleType               String    @default("CASH") @map("SALE_TYPE") @db.NVarChar(10)  // CASH | CREDIT
  dueDate                DateTime? @map("DUE_DATE")
  isPaid                 Boolean   @default(true) @map("IS_PAID")
  paidAmount             Decimal?  @map("PAID_AMOUNT") @db.Decimal(18, 2)
  // Payment breakdown for MIXED or audit purposes
  cashAmount             Decimal?  @map("CASH_AMOUNT") @db.Decimal(18, 2)
  cardAmount             Decimal?  @map("CARD_AMOUNT") @db.Decimal(18, 2)
  transferAmount         Decimal?  @map("TRANSFER_AMOUNT") @db.Decimal(18, 2)
  transferDocumentNumber String?   @map("TRANSFER_DOCUMENT_NUMBER") @db.NVarChar(100)
  isVoided               Boolean   @default(false) @map("IS_VOIDED")
  voidedById             String?   @map("VOIDED_BY_ID") @db.NVarChar(36)
  voidedAt               DateTime? @map("VOIDED_AT")
  voidReason             String?   @map("VOID_REASON") @db.NVarChar(500)
  notes                  String?   @map("NOTES") @db.NVarChar(Max)
  createdAt              DateTime  @default(now()) @map("CREATED_AT")

  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cashier         User            @relation("CashierSales", fields: [cashierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer        Customer?       @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  cashRegister    CashRegister?   @relation(fields: [cashRegisterId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  voidedBy        User?           @relation("VoidedSales", fields: [voidedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           SaleItem[]
  creditPayments  CreditPayment[]
  quotation       Quotation?

  @@map("SALES")
}

model CreditPayment {
  id                     String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  saleId                 String   @map("SALE_ID") @db.NVarChar(36)
  amount                 Decimal  @map("AMOUNT") @db.Decimal(18, 2)
  paymentMethod          String   @map("PAYMENT_METHOD") @db.NVarChar(20)  // CASH | TRANSFER
  transferDocumentNumber String?  @map("TRANSFER_DOCUMENT_NUMBER") @db.NVarChar(100)
  transferBank           String?  @map("TRANSFER_BANK") @db.NVarChar(100)
  notes                  String?  @map("NOTES") @db.NVarChar(500)
  paidById               String   @map("PAID_BY_ID") @db.NVarChar(36)
  createdAt              DateTime @default(now()) @map("CREATED_AT")

  sale    Sale @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  paidBy  User @relation(fields: [paidById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("CREDIT_PAYMENTS")
}

model SaleItem {
  id          String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  saleId      String   @map("SALE_ID") @db.NVarChar(36)
  productId   String   @map("PRODUCT_ID") @db.NVarChar(36)
  variationId String?  @map("VARIATION_ID") @db.NVarChar(36)
  quantity    Decimal  @map("QUANTITY") @db.Decimal(18, 4)
  unitPrice   Decimal  @map("UNIT_PRICE") @db.Decimal(18, 2)
  discount    Decimal  @default(0) @map("DISCOUNT") @db.Decimal(5, 4)
  total       Decimal  @map("TOTAL") @db.Decimal(18, 2)

  sale      Sale              @relation(fields: [saleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product   Product           @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variation ProductVariation? @relation(fields: [variationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("SALE_ITEMS")
}

model PurchaseOrder {
  id           String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  orderNumber  String    @unique @map("ORDER_NUMBER") @db.NVarChar(30)
  supplierId   String    @map("SUPPLIER_ID") @db.NVarChar(36)
  branchId     String    @map("BRANCH_ID") @db.NVarChar(36)
  subtotal     Decimal   @map("SUBTOTAL") @db.Decimal(18, 2)
  tax          Decimal   @default(0) @map("TAX") @db.Decimal(18, 2)
  total        Decimal   @map("TOTAL") @db.Decimal(18, 2)
  status       String    @default("DRAFT") @map("STATUS") @db.NVarChar(20)  // DRAFT | PENDING | PARTIAL | RECEIVED | CANCELLED
  expectedDate DateTime? @map("EXPECTED_DATE")
  receivedDate DateTime? @map("RECEIVED_DATE")
  notes        String?   @map("NOTES") @db.NVarChar(Max)
  createdById  String    @map("CREATED_BY_ID") @db.NVarChar(36)
  receivedById String?   @map("RECEIVED_BY_ID") @db.NVarChar(36)
  createdAt    DateTime  @default(now()) @map("CREATED_AT")
  updatedAt    DateTime  @updatedAt @map("UPDATED_AT")

  supplier   Supplier            @relation(fields: [supplierId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  branch     Branch              @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy  User                @relation("CreatedBy", fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivedBy User?               @relation("ReceivedBy", fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items      PurchaseOrderItem[]

  @@map("PURCHASE_ORDERS")
}

model PurchaseOrderItem {
  id               String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  purchaseOrderId  String   @map("PURCHASE_ORDER_ID") @db.NVarChar(36)
  productId        String   @map("PRODUCT_ID") @db.NVarChar(36)
  productName      String   @map("PRODUCT_NAME") @db.NVarChar(200)
  quantity         Decimal  @map("QUANTITY") @db.Decimal(18, 4)
  receivedQuantity Decimal  @default(0) @map("RECEIVED_QUANTITY") @db.Decimal(18, 4)
  unitCost         Decimal  @map("UNIT_COST") @db.Decimal(18, 2)
  total            Decimal  @map("TOTAL") @db.Decimal(18, 2)

  purchaseOrder PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product       Product       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PURCHASE_ORDER_ITEMS")
}

model Transfer {
  id            String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  fromBranchId  String    @map("FROM_BRANCH_ID") @db.NVarChar(36)
  toBranchId    String    @map("TO_BRANCH_ID") @db.NVarChar(36)
  status        String    @default("PENDING") @map("STATUS") @db.NVarChar(20)  // PENDING | APPROVED | IN_TRANSIT | RECEIVED | REJECTED
  notes         String?   @map("NOTES") @db.NVarChar(Max)
  requestedById String    @map("REQUESTED_BY_ID") @db.NVarChar(36)
  approvedById  String?   @map("APPROVED_BY_ID") @db.NVarChar(36)
  receivedById  String?   @map("RECEIVED_BY_ID") @db.NVarChar(36)
  createdAt     DateTime  @default(now()) @map("CREATED_AT")
  approvedAt    DateTime? @map("APPROVED_AT")
  receivedAt    DateTime? @map("RECEIVED_AT")

  fromBranch  Branch         @relation("FromBranch", fields: [fromBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toBranch    Branch         @relation("ToBranch", fields: [toBranchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  requestedBy User           @relation("RequestedBy", fields: [requestedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy  User?          @relation("ApprovedBy", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  receivedBy  User?          @relation("ReceivedByUser", fields: [receivedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items       TransferItem[]

  @@map("TRANSFERS")
}

model TransferItem {
  id         String  @id @default(cuid()) @map("ID") @db.NVarChar(36)
  transferId String  @map("TRANSFER_ID") @db.NVarChar(36)
  productId  String  @map("PRODUCT_ID") @db.NVarChar(36)
  quantity   Decimal @map("QUANTITY") @db.Decimal(18, 4)

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product  Product  @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("TRANSFER_ITEMS")
}

model Quotation {
  id                String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  quotationNumber   String    @unique @map("QUOTATION_NUMBER") @db.NVarChar(30)
  branchId          String    @map("BRANCH_ID") @db.NVarChar(36)
  customerId        String    @map("CUSTOMER_ID") @db.NVarChar(36)
  subtotal          Decimal   @map("SUBTOTAL") @db.Decimal(18, 2)
  tax               Decimal   @default(0) @map("TAX") @db.Decimal(18, 2)
  discount          Decimal   @default(0) @map("DISCOUNT") @db.Decimal(18, 2)
  total             Decimal   @map("TOTAL") @db.Decimal(18, 2)
  status            String    @default("DRAFT") @map("STATUS") @db.NVarChar(20)  // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  validUntil        DateTime  @map("VALID_UNTIL")
  notes             String?   @map("NOTES") @db.NVarChar(Max)
  createdById       String    @map("CREATED_BY_ID") @db.NVarChar(36)
  convertedToSaleId String?   @unique @map("CONVERTED_TO_SALE_ID") @db.NVarChar(36)
  createdAt         DateTime  @default(now()) @map("CREATED_AT")
  updatedAt         DateTime  @updatedAt @map("UPDATED_AT")

  branch          Branch          @relation(fields: [branchId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  customer        Customer        @relation(fields: [customerId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  createdBy       User            @relation(fields: [createdById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  convertedToSale Sale?           @relation(fields: [convertedToSaleId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items           QuotationItem[]

  @@map("QUOTATIONS")
}

model QuotationItem {
  id          String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  quotationId String   @map("QUOTATION_ID") @db.NVarChar(36)
  productId   String   @map("PRODUCT_ID") @db.NVarChar(36)
  variationId String?  @map("VARIATION_ID") @db.NVarChar(36)
  quantity    Decimal  @map("QUANTITY") @db.Decimal(18, 4)
  unitPrice   Decimal  @map("UNIT_PRICE") @db.Decimal(18, 2)
  discount    Decimal  @default(0) @map("DISCOUNT") @db.Decimal(5, 4)
  total       Decimal  @map("TOTAL") @db.Decimal(18, 2)

  quotation Quotation         @relation(fields: [quotationId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product   Product           @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  variation ProductVariation? @relation(fields: [variationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("QUOTATION_ITEMS")
}

model AuditLog {
  id        String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  userId    String?  @map("USER_ID") @db.NVarChar(36)
  action    String   @map("ACTION") @db.NVarChar(50)
  entity    String   @map("ENTITY") @db.NVarChar(60)
  entityId  String?  @map("ENTITY_ID") @db.NVarChar(36)
  oldValues String?  @map("OLD_VALUES") @db.NVarChar(Max)
  newValues String?  @map("NEW_VALUES") @db.NVarChar(Max)
  ipAddress String?  @map("IP_ADDRESS") @db.NVarChar(45)
  userAgent String?  @map("USER_AGENT") @db.NVarChar(500)
  createdAt DateTime @default(now()) @map("CREATED_AT")

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("AUDIT_LOGS")
}

model LoginHistory {
  id         String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  userId     String?  @map("USER_ID") @db.NVarChar(36)
  email      String   @map("EMAIL") @db.NVarChar(150)
  success    Boolean  @map("SUCCESS")
  ipAddress  String?  @map("IP_ADDRESS") @db.NVarChar(45)
  userAgent  String?  @map("USER_AGENT") @db.NVarChar(500)
  failReason String?  @map("FAIL_REASON") @db.NVarChar(200)
  createdAt  DateTime @default(now()) @map("CREATED_AT")

  user User? @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("LOGIN_HISTORY")
}

model PriceHistory {
  id          String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  productId   String   @map("PRODUCT_ID") @db.NVarChar(36)
  field       String   @map("FIELD") @db.NVarChar(30)
  oldValue    Decimal  @map("OLD_VALUE") @db.Decimal(18, 2)
  newValue    Decimal  @map("NEW_VALUE") @db.Decimal(18, 2)
  changedById String   @map("CHANGED_BY_ID") @db.NVarChar(36)
  createdAt   DateTime @default(now()) @map("CREATED_AT")

  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  changedBy User    @relation(fields: [changedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PRICE_HISTORY")
}

// ── Teacher Portal (Variedades Dayana) ───────────────────────────────────────
// NOTE: After editing this schema run from dengo-backend/:
//   npx prisma generate && npx prisma db push

model PortalConfig {
  id           String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  businessName String   @map("BUSINESS_NAME") @db.NVarChar(150)
  tagline      String?  @map("TAGLINE") @db.NVarChar(200)
  aboutText    String?  @map("ABOUT_TEXT") @db.NVarChar(Max)
  logoUrl      String?  @map("LOGO_URL") @db.NVarChar(500)
  heroImageUrl String?  @map("HERO_IMAGE_URL") @db.NVarChar(500)
  primaryColor String   @default("#F97316") @map("PRIMARY_COLOR") @db.NVarChar(20)
  address      String?  @map("ADDRESS") @db.NVarChar(300)
  city         String?  @map("CITY") @db.NVarChar(100)
  phone        String?  @map("PHONE") @db.NVarChar(30)
  whatsapp     String?  @map("WHATSAPP") @db.NVarChar(30)
  email        String?  @map("EMAIL") @db.NVarChar(150)
  facebook     String?  @map("FACEBOOK") @db.NVarChar(200)
  instagram    String?  @map("INSTAGRAM") @db.NVarChar(200)
  isActive     Boolean  @default(true) @map("IS_ACTIVE")
  createdAt    DateTime @default(now()) @map("CREATED_AT")
  updatedAt    DateTime @updatedAt @map("UPDATED_AT")

  @@map("PORTAL_CONFIG")
}

model School {
  id           String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  name         String   @map("NAME") @db.NVarChar(200)
  code         String?  @map("CODE") @db.NVarChar(30)
  address      String?  @map("ADDRESS") @db.NVarChar(300)
  municipio    String?  @map("MUNICIPIO") @db.NVarChar(100)
  departamento String?  @map("DEPARTAMENTO") @db.NVarChar(100)
  opfContact   String?  @map("OPF_CONTACT") @db.NVarChar(150)
  opfPhone     String?  @map("OPF_PHONE") @db.NVarChar(30)
  isActive     Boolean  @default(true) @map("IS_ACTIVE")
  createdAt    DateTime @default(now()) @map("CREATED_AT")
  updatedAt    DateTime @updatedAt @map("UPDATED_AT")

  teachers TeacherSchool[]
  orders   PortalOrder[]

  @@map("SCHOOLS")
}

model Teacher {
  id        String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  userId    String   @unique @map("USER_ID") @db.NVarChar(36)
  phone     String?  @map("PHONE") @db.NVarChar(30)
  isActive  Boolean  @default(true) @map("IS_ACTIVE")
  createdAt DateTime @default(now()) @map("CREATED_AT")
  updatedAt DateTime @updatedAt @map("UPDATED_AT")

  user    User            @relation(fields: [userId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  schools TeacherSchool[]
  orders  PortalOrder[]
  messages PortalMessage[]

  @@map("TEACHERS")
}

model TeacherSchool {
  id        String  @id @default(cuid()) @map("ID") @db.NVarChar(36)
  teacherId String  @map("TEACHER_ID") @db.NVarChar(36)
  schoolId  String  @map("SCHOOL_ID") @db.NVarChar(36)
  grade            String? @map("GRADE") @db.NVarChar(100)
  section          String? @map("SECTION") @db.NVarChar(10)
  educationalLevel String? @map("EDUCATIONAL_LEVEL") @db.NVarChar(20)
  isActive         Boolean @default(true) @map("IS_ACTIVE")

  teacher Teacher @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school  School  @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([teacherId, schoolId, grade])
  @@map("TEACHER_SCHOOLS")
}

model ProgramConfig {
  id                  String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  type                String   @map("TYPE") @db.NVarChar(30)
  name                String   @map("NAME") @db.NVarChar(150)
  description         String?  @map("DESCRIPTION") @db.NVarChar(500)
  maxAmountPerTeacher Decimal? @map("MAX_AMOUNT_PER_TEACHER") @db.Decimal(18, 2)
  limitPerStudent     Decimal? @map("LIMIT_PER_STUDENT") @db.Decimal(18, 2)
  allowedCategoryIds  String?  @map("ALLOWED_CATEGORY_IDS") @db.NVarChar(Max)
  isActive            Boolean  @default(true) @map("IS_ACTIVE")
  createdAt           DateTime @default(now()) @map("CREATED_AT")
  updatedAt           DateTime @updatedAt @map("UPDATED_AT")

  @@map("PROGRAM_CONFIGS")
}

model PortalOrder {
  id           String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  orderNumber  String    @unique @map("ORDER_NUMBER") @db.NVarChar(30)
  teacherId    String    @map("TEACHER_ID") @db.NVarChar(36)
  schoolId     String    @map("SCHOOL_ID") @db.NVarChar(36)
  grade             String?   @map("GRADE") @db.NVarChar(100)
  educationalLevel  String?   @map("EDUCATIONAL_LEVEL") @db.NVarChar(20)
  studentCount      Int?      @map("STUDENT_COUNT")
  orderGradeSummary String?   @map("ORDER_GRADE_SUMMARY") @db.NVarChar(300)
  programType       String    @map("PROGRAM_TYPE") @db.NVarChar(30)
  status       String    @default("PENDING") @map("STATUS") @db.NVarChar(20)
  notes        String?   @map("NOTES") @db.NVarChar(Max)
  totalAmount  Decimal   @default(0) @map("TOTAL_AMOUNT") @db.Decimal(18, 2)
  adminNotes    String?   @map("ADMIN_NOTES") @db.NVarChar(Max)
  approvedById  String?   @map("APPROVED_BY_ID") @db.NVarChar(36)
  approvedAt    DateTime? @map("APPROVED_AT")
  deliveryDate  DateTime? @map("DELIVERY_DATE")
  deliveryTime  String?   @map("DELIVERY_TIME") @db.NVarChar(10)
  deliveryNotes String?   @map("DELIVERY_NOTES") @db.NVarChar(500)
  createdAt     DateTime  @default(now()) @map("CREATED_AT")
  updatedAt     DateTime  @updatedAt @map("UPDATED_AT")

  teacher    Teacher             @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  school     School              @relation(fields: [schoolId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  approvedBy User?               @relation("ApprovedPortalOrders", fields: [approvedById], references: [id], onDelete: NoAction, onUpdate: NoAction)
  items      PortalOrderItem[]
  grades     PortalOrderGrade[]
  messages   PortalMessage[]

  @@map("PORTAL_ORDERS")
}

model PortalOrderItem {
  id            String  @id @default(cuid()) @map("ID") @db.NVarChar(36)
  portalOrderId String  @map("PORTAL_ORDER_ID") @db.NVarChar(36)
  productId     String  @map("PRODUCT_ID") @db.NVarChar(36)
  productName   String  @map("PRODUCT_NAME") @db.NVarChar(200)
  quantity      Decimal @map("QUANTITY") @db.Decimal(18, 4)
  unitPrice     Decimal @map("UNIT_PRICE") @db.Decimal(18, 2)
  total         Decimal @map("TOTAL") @db.Decimal(18, 2)
  notes         String? @map("NOTES") @db.NVarChar(500)

  portalOrder PortalOrder @relation(fields: [portalOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product     Product     @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PORTAL_ORDER_ITEMS")
}

model ProgramOption {
  id          String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  programType String   @map("PROGRAM_TYPE") @db.NVarChar(30)
  name        String   @map("NAME") @db.NVarChar(150)
  description String?  @map("DESCRIPTION") @db.NVarChar(500)
  isActive    Boolean  @default(true) @map("IS_ACTIVE")
  sortOrder   Int      @default(0) @map("SORT_ORDER")
  createdAt   DateTime @default(now()) @map("CREATED_AT")
  updatedAt   DateTime @updatedAt @map("UPDATED_AT")

  items  ProgramOptionItem[]
  levels ProgramOptionLevel[]

  @@map("PROGRAM_OPTIONS")
}

model ProgramOptionItem {
  id              String  @id @default(cuid()) @map("ID") @db.NVarChar(36)
  programOptionId String  @map("PROGRAM_OPTION_ID") @db.NVarChar(36)
  productId       String  @map("PRODUCT_ID") @db.NVarChar(36)
  productName     String  @map("PRODUCT_NAME") @db.NVarChar(200)
  quantity        Decimal @map("QUANTITY") @db.Decimal(18, 4)

  programOption ProgramOption @relation(fields: [programOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  product       Product       @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PROGRAM_OPTION_ITEMS")
}

model ProgramOptionLevel {
  programOptionId String @map("PROGRAM_OPTION_ID") @db.NVarChar(36)
  level           String @map("LEVEL") @db.NVarChar(20)

  programOption ProgramOption @relation(fields: [programOptionId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@id([programOptionId, level])
  @@map("PROGRAM_OPTION_LEVELS")
}

model PortalOrderGrade {
  id            String @id @default(cuid()) @map("ID") @db.NVarChar(36)
  portalOrderId String @map("PORTAL_ORDER_ID") @db.NVarChar(36)
  gradeName     String @map("GRADE_NAME") @db.NVarChar(100)
  studentCount  Int    @map("STUDENT_COUNT")

  portalOrder PortalOrder @relation(fields: [portalOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PORTAL_ORDER_GRADES")
}

model PortalPurchaseTracking {
  id           String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  productId    String   @map("PRODUCT_ID") @db.NVarChar(36)
  programType  String   @map("PROGRAM_TYPE") @db.NVarChar(30)
  fiscalYear   Int      @map("FISCAL_YEAR")
  purchasedQty Decimal  @default(0) @map("PURCHASED_QTY") @db.Decimal(18, 4)
  notes        String?  @map("NOTES") @db.NVarChar(500)
  updatedAt    DateTime @default(now()) @updatedAt @map("UPDATED_AT")
  updatedById  String?  @map("UPDATED_BY_ID") @db.NVarChar(36)

  product   Product @relation(fields: [productId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  updatedBy User?   @relation("UpdatedByUser", fields: [updatedById], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([productId, programType, fiscalYear])
  @@map("PORTAL_PURCHASE_TRACKING")
}

model PortalMessage {
  id            String   @id @default(cuid()) @map("ID") @db.NVarChar(36)
  portalOrderId String?  @map("PORTAL_ORDER_ID") @db.NVarChar(36)
  teacherId     String   @map("TEACHER_ID") @db.NVarChar(36)
  senderRole    String   @map("SENDER_ROLE") @db.NVarChar(10)
  body          String   @map("BODY") @db.NVarChar(Max)
  isRead        Boolean  @default(false) @map("IS_READ")
  createdAt     DateTime @default(now()) @map("CREATED_AT")

  portalOrder PortalOrder? @relation(fields: [portalOrderId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  teacher     Teacher      @relation(fields: [teacherId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("PORTAL_MESSAGES")
}

model InternalMessage {
  id         String    @id @default(cuid()) @map("ID") @db.NVarChar(36)
  fromUserId String    @map("FROM_USER_ID") @db.NVarChar(36)
  toUserId   String    @map("TO_USER_ID") @db.NVarChar(36)
  body       String    @map("BODY") @db.NVarChar(Max)
  isRead     Boolean   @default(false) @map("IS_READ")
  readAt     DateTime? @map("READ_AT")
  createdAt  DateTime  @default(now()) @map("CREATED_AT")

  fromUser User @relation("SentMessages", fields: [fromUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  toUser   User @relation("ReceivedMessages", fields: [toUserId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("INTERNAL_MESSAGES")
}
