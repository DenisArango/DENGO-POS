---
import type { Block } from '../core/types'
const { block, categories } = Astro.props as { block: Block; categories: { id: string; name: string }[] }
const p = block.props as { title?: string }
const list = categories.slice(0, 24)
---
{list.length > 0 && (
  <section class="section cats">
    <div class="wrap cats__grid">
      <div class="cats__head">
        <h2 class="display h-section h-mark" data-reveal>{p.title || 'Lo que encontrarás'}</h2>
        <p class="lead soft" data-reveal style="--i:1">{list.length} {list.length === 1 ? 'categoría' : 'categorías'} en nuestras tiendas. Pregúntanos por lo que no veas aquí.</p>
      </div>
      <ul class="cats__list">
        {list.map((c, i) => <li data-reveal style={`--i:${Math.min(i, 8)}`}><span class="cats__dot" aria-hidden="true"></span>{c.name}</li>)}
      </ul>
    </div>
  </section>
)}

<style>
  .cats { background: var(--brand-tint); }
  .cats__grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(24px, 5vw, 80px); align-items: start; }
  .cats__head { position: sticky; top: 110px; }
  .cats__head .h-section { margin-bottom: 18px; }
  .cats__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 10px 12px; }
  .cats__list li { display: inline-flex; align-items: center; gap: 12px; font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(1.25rem, 1rem + 1.2vw, 2rem); line-height: 1.1; padding: 14px 22px 14px 18px; background: var(--card); border-radius: var(--btn-radius); box-shadow: var(--shadow); transition: transform 240ms var(--ease-out), background-color 240ms ease, color 240ms ease; }
  :global([data-theme='editorial']) .cats__list li { box-shadow: inset 0 0 0 1px var(--ink); background: none; }
  .cats__dot { width: 10px; height: 10px; border-radius: 50%; background: var(--brand-2); flex-shrink: 0; }
  @media (hover: hover) { .cats__list li:hover { transform: translateY(-3px) rotate(-1deg); background: var(--brand); color: var(--on-brand); } }
  @media (max-width: 760px) { .cats__grid { grid-template-columns: 1fr; } .cats__head { position: static; } }
</style>
