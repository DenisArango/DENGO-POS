---
import type { Block } from '../core/types'
const { block } = Astro.props as { block: Block }
const p = block.props as { title?: string; items?: { title: string; text: string }[] }
const items = (p.items ?? []).filter(i => i.title?.trim())
---
{items.length > 0 && (
  <section class="section features">
    <div class="wrap">
      <h2 class="display h-section h-mark" data-reveal>{p.title || 'Por qué elegirnos'}</h2>
      <ul class:list={['features__list', `n${Math.min(items.length, 4)}`]}>
        {items.map((it, i) => (
          <li class="feature" data-reveal style={`--i:${i + 1}`}>
            <span class="feature__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="feature__t">{it.title}</h3>
            {it.text && <p>{it.text}</p>}
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<style>
  .features__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: clamp(14px, 2vw, 24px); }
  .features__list.n4 { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
  .feature { position: relative; display: grid; align-content: start; gap: 12px; padding: clamp(24px, 3vw, 38px); background: var(--card); border-radius: var(--radius-lg); box-shadow: var(--shadow); overflow: hidden; transition: transform 300ms var(--ease-out), box-shadow 300ms var(--ease-out); }
  .feature::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 4px; background: var(--brand-2); transform: scaleX(0); transform-origin: left; transition: transform 400ms var(--ease-out); }
  @media (hover: hover) { .feature:hover { transform: translateY(-4px); box-shadow: var(--shadow-lg); } .feature:hover::after { transform: scaleX(1); } }
  :global([data-theme='editorial']) .feature { background: none; border-top: 2px solid var(--ink); padding-inline: 0; }
  .feature__n { font-family: var(--font-display); font-weight: var(--display-weight); font-size: clamp(2.25rem, 1.6rem + 2vw, 3.25rem); line-height: 1; color: var(--brand-2); letter-spacing: var(--display-track); font-variant-numeric: tabular-nums; }
  .feature__t { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(1.5rem, 1.2rem + 1vw, 2rem); line-height: 1.08; margin: 4px 0 0; }
  .feature p { max-width: 36ch; color: var(--soft); }
</style>
