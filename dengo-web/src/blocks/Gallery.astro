---
import type { Block } from '../core/types'
const { block } = Astro.props as { block: Block }
const p = block.props as { title?: string; images?: { src: string; caption?: string }[] }
const images = (p.images ?? []).filter(i => i?.src)
---
{images.length > 0 && (
  <section class="section gallery">
    <div class="wrap">
      <h2 class="display h-section h-mark" data-reveal>{p.title || 'Nuestras tiendas'}</h2>
      <div class="gallery__grid">
        {images.map((img, i) => (
          <figure data-reveal style={`--i:${i % 4}`} class:list={[{ wide: i % 5 === 0 }]}>
            <img src={img.src} alt={img.caption || ''} loading="lazy" decoding="async" width="800" height="600" />
            {img.caption && <figcaption>{img.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .gallery__grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; }
  .gallery__grid figure { position: relative; margin: 0; overflow: hidden; border-radius: var(--radius); }
  .gallery__grid .wide { grid-column: span 2; grid-row: span 2; }
  .gallery__grid img { width: 100%; height: 100%; aspect-ratio: 4 / 3; object-fit: cover; transition: transform 700ms var(--ease-out); }
  @media (hover: hover) { .gallery__grid figure:hover img { transform: scale(1.06); } }
  .gallery__grid figcaption { position: absolute; left: 10px; bottom: 10px; max-width: calc(100% - 20px); font-size: var(--step-small); font-weight: 600; color: #fff; padding: 8px 12px; border-radius: calc(var(--radius) * 0.7); background: rgb(0 0 0 / 0.55); -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px); }
  @media (max-width: 760px) { .gallery__grid { grid-template-columns: repeat(2, 1fr); } }
</style>
