---
import { waLink, offerHeadline } from '../core/api'
import { openState } from '../core/hours'
import type { SiteContent } from '../core/types'
const { content } = Astro.props as { content: SiteContent }
const title = content.heroTitle || content.businessName
const sub = content.heroSubtitle || content.tagline || 'Visítanos en cualquiera de nuestras tiendas.'
const wa = waLink(content.contact.whatsapp, `Hola ${content.businessName}, quiero información.`)
const hasOffers = content.promotions.length > 0
const featured = content.promotions.find(p => p.featured) ?? content.promotions[0]
const main = content.branches[0]
const st = main ? openState(main.openTime, main.closeTime) : null
const initials = content.businessName.split(/\s+/).filter(w => w.length > 2).slice(0, 2).map(w => w[0]).join('') || content.businessName.charAt(0)
---
<section class="hero">
  <div class="wrap hero__grid">
    <div class="hero__text">
      {main && st?.label && (
        <p class="hero__state" data-reveal data-open={main.openTime} data-close={main.closeTime}>
          <span class="status" data-is-open={st.open ? '1' : '0'}>{st.label}</span>
          {content.branches.length > 1 && <span class="hero__count">· {content.branches.length} sucursales</span>}
        </p>
      )}
      <h1 class="display hero__title" data-reveal style="--i:1">{title}</h1>
      <p class="lead" data-reveal style="--i:2">{sub}</p>
      <div class="hero__actions" data-reveal style="--i:3">
        {hasOffers && <a class="btn btn--accent" href="/ofertas">Ver ofertas vigentes <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>}
        {wa && <a class={hasOffers ? 'btn btn--ghost' : 'btn'} href={wa} target="_blank" rel="noopener">Escríbenos por WhatsApp</a>}
      </div>
    </div>
    <div class="hero__art" data-reveal style="--i:1">
      <span class="hero__back" aria-hidden="true"></span>
      {content.heroImage ? (
        <figure class="hero__media">
          <img src={content.heroImage} alt={content.businessName} width="1200" height="1400" fetchpriority="high" />
        </figure>
      ) : (
        <div class="hero__mark" aria-hidden="true">
          <span class="hero__mono">{initials}</span>
          <span class="hero__name">{content.businessName}</span>
        </div>
      )}
      {featured && (
        <a class="hero__offer" href={`/ofertas/${featured.slug}`}>
          <span class="hero__offer-v">{offerHeadline(featured)}</span>
          <span class="hero__offer-t"><b>{featured.name}</b><span>Obtén tu cupón</span></span>
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .hero { padding-block: clamp(36px, 6vw, 96px) calc(var(--section-gap) / 2); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: clamp(32px, 6vw, 88px); align-items: center; }
  .hero__state { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-bottom: 22px; padding: 8px 14px; border-radius: 999px; background: var(--card); box-shadow: var(--shadow); width: fit-content; font-size: 0.9375rem; }
  :global([data-theme='editorial']) .hero__state { box-shadow: inset 0 0 0 1px var(--ink); border-radius: 0; }
  .hero__count { color: var(--soft); font-weight: 500; }
  @media (max-width: 520px) { .hero__count { display: none; } }
  .hero__title { font-size: var(--step-hero); margin-bottom: clamp(20px, 2.4vw, 32px); max-width: 12ch; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: clamp(28px, 3vw, 44px); }

  .hero__art { position: relative; padding: 0 0 28px 28px; }
  .hero__back { position: absolute; inset: 28px 28px 0 0; border-radius: var(--radius-lg); background: var(--brand-2); opacity: 0.9; }
  :global([data-theme='editorial']) .hero__back { inset: 18px 18px 0 0; background: none; border: 2px solid var(--ink); opacity: 1; }
  .hero__media, .hero__mark { position: relative; margin: 0; aspect-ratio: 5 / 6; overflow: hidden; border-radius: var(--radius-lg); background: var(--surface); box-shadow: var(--shadow-lg); }
  .hero__media img { width: 100%; height: 100%; object-fit: cover; animation: drift 18s ease-in-out infinite alternate; }
  @keyframes drift { from { transform: scale(1.04); } to { transform: scale(1.12) translate3d(-1.5%, -1%, 0); } }
  @media (prefers-reduced-motion: reduce) { .hero__media img { animation: none; } }
  .hero__mark { background: var(--brand); color: var(--on-brand); display: grid; grid-template-rows: 1fr auto; padding: clamp(24px, 3vw, 44px);
    background-image: radial-gradient(circle at 100% 0%, color-mix(in oklab, var(--brand-2) 55%, transparent) 0 30%, transparent 30.5%), radial-gradient(circle at 0% 100%, color-mix(in oklab, var(--on-brand) 10%, transparent) 0 42%, transparent 42.5%); }
  .hero__mono { align-self: center; font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(7rem, 16vw, 15rem); line-height: 0.8; }
  .hero__name { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(1.75rem, 2.6vw, 2.6rem); line-height: 1; overflow-wrap: anywhere; }
  .hero__offer { position: absolute; left: 0; bottom: 0; display: flex; align-items: center; gap: 16px; max-width: calc(100% - 40px); padding: 16px 22px 16px 16px; background: var(--card); color: var(--ink); text-decoration: none; border-radius: var(--radius); box-shadow: var(--shadow-lg); transition: transform 260ms var(--ease-out); animation: bob 5s ease-in-out infinite alternate; }
  :global([data-theme='editorial']) .hero__offer { box-shadow: 6px 6px 0 var(--ink); border: 2px solid var(--ink); }
  @keyframes bob { to { transform: translateY(-8px); } }
  @media (prefers-reduced-motion: reduce) { .hero__offer { animation: none; } }
  .hero__offer:active { transform: scale(0.98); }
  @media (hover: hover) { .hero__offer:hover { animation-play-state: paused; transform: translateY(-4px); } }
  .hero__offer-v { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(2rem, 1.4rem + 2vw, 3rem); line-height: 1; color: var(--brand); padding: 12px 14px; border-radius: calc(var(--radius) * 0.7); background: var(--brand-tint); font-variant-numeric: tabular-nums; }
  .hero__offer-t { display: grid; gap: 2px; min-width: 0; font-size: 0.9375rem; }
  .hero__offer-t b { font-size: 1.0625rem; line-height: 1.2; }
  .hero__offer-t span { color: var(--brand-2); font-weight: 700; }

  :global([data-theme='editorial']) .hero__grid { grid-template-columns: 1fr; }
  :global([data-theme='editorial']) .hero__title { max-width: 14ch; }
  :global([data-theme='editorial']) .hero__media, :global([data-theme='editorial']) .hero__mark { aspect-ratio: 21 / 9; }
  @media (max-width: 860px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__media, .hero__mark, :global([data-theme='editorial']) .hero__media, :global([data-theme='editorial']) .hero__mark { aspect-ratio: 4 / 3; }
    .hero__art { padding: 0 0 22px 16px; }
    .hero__back { inset: 18px 16px 0 0; }
  }
</style>
