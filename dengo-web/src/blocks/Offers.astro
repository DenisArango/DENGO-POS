---
// The offers as real coupons: a value stub and a body separated by a
// perforation, with the notches cut out of both edges.
import { offerHeadline, fmtDay } from '../core/api'
import type { Block, Promotion } from '../core/types'
interface Props { block: Block; promotions: Promotion[]; full?: boolean; heading?: boolean }
const { block, promotions, full, heading = true } = Astro.props
const p = block.props as { title?: string; subtitle?: string }
const list = full ? promotions : promotions.slice(0, 6)
---
{list.length > 0 && (
  <section class:list={['section', 'offers', { 'offers--page': !heading }]} id="ofertas">
    <div class="wrap">
      {heading && (
        <div class="offers__head">
          <h2 class="display h-section h-mark" data-reveal>{p.title || 'Ofertas vigentes'}</h2>
          <p class="lead" data-reveal style="--i:1">{p.subtitle || 'Obtén tu cupón y preséntalo en caja.'}</p>
        </div>
      )}
      <ul class="offers__list">
        {list.map((o, i) => (
          <li class:list={['coupon', { 'coupon--featured': o.featured }]} data-reveal style={`--i:${(i % 3) + 1}`}>
            <a href={`/ofertas/${o.slug}`} class="coupon__link">
              <span class="coupon__value">{offerHeadline(o)}</span>
              <span class="coupon__body">
                {o.featured && <span class="coupon__flag">Destacada</span>}
                <span class="coupon__name">{o.name}</span>
                <span class="coupon__meta">{o.summary}</span>
                <span class="coupon__foot">
                  <span>{o.endsAt ? `Hasta el ${fmtDay(o.endsAt)}` : 'Por tiempo limitado'}{o.couponsLeft !== null ? ` · quedan ${o.couponsLeft}` : ''}</span>
                  <span class="coupon__cta">Obtener cupón <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6" /></svg></span>
                </span>
              </span>
            </a>
          </li>
        ))}
      </ul>
      {!full && promotions.length > list.length && <p class="offers__more"><a class="btn btn--light" href="/ofertas">Ver todas las ofertas ({promotions.length})</a></p>}
    </div>
  </section>
)}

<style>
  .offers { background: var(--brand); color: var(--on-brand); }
  .offers--page { background: var(--ground); color: var(--ink); }
  .offers .lead { color: inherit; opacity: 0.9; }
  .offers .h-mark::before { background: var(--brand-2); }
  :global([data-theme='editorial']) .offers .h-mark::before { background: currentColor; }
  .offers__head { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; align-items: end; margin-bottom: clamp(28px, 4vw, 56px); }
  .offers__head .h-section { margin: 0; }
  .offers__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 460px), 1fr)); gap: clamp(14px, 2vw, 22px); }

  .coupon__link {
    --notch: 14px; --at: 34%;
    position: relative; height: 100%; display: grid; grid-template-columns: var(--at) 1fr; text-decoration: none;
    background: var(--card); color: var(--ink); border-radius: var(--radius);
    -webkit-mask: radial-gradient(circle var(--notch) at var(--at) 0, #0000 98%, #000) top / 100% 51% no-repeat, radial-gradient(circle var(--notch) at var(--at) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
            mask: radial-gradient(circle var(--notch) at var(--at) 0, #0000 98%, #000) top / 100% 51% no-repeat, radial-gradient(circle var(--notch) at var(--at) 100%, #0000 98%, #000) bottom / 100% 51% no-repeat;
    transition: transform 260ms var(--ease-out);
  }
  .coupon__link:active { transform: scale(0.985); }
  @media (hover: hover) and (pointer: fine) { .coupon__link:hover { transform: translateY(-4px); } .coupon__link:hover .coupon__cta svg { transform: translateX(4px); } }
  .coupon__value { display: grid; place-items: center; padding: 22px 12px; background: var(--brand-tint); color: var(--brand); border-right: 3px dashed color-mix(in oklab, var(--ink) 22%, transparent);
    font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(2.5rem, 1.6rem + 2.6vw, 4rem); line-height: 1; font-variant-numeric: tabular-nums; text-align: center; overflow-wrap: anywhere; }
  .coupon__body { display: grid; align-content: start; gap: 6px; padding: clamp(18px, 2.2vw, 26px); min-width: 0; }
  .coupon__flag { justify-self: start; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; padding: 4px 10px; border-radius: 999px; background: var(--brand-2); color: var(--on-brand-2); }
  .coupon__name { font-weight: 700; font-size: clamp(1.1875rem, 1.05rem + 0.5vw, 1.375rem); line-height: 1.2; }
  .coupon__meta { color: var(--soft); font-size: 1rem; }
  .coupon__foot { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 16px; margin-top: 10px; padding-top: 12px; border-top: 1px solid var(--line); font-size: 0.875rem; color: var(--soft); }
  .coupon__cta { display: inline-flex; align-items: center; gap: 6px; font-weight: 700; font-size: 0.9375rem; color: var(--brand-2); }
  .coupon__cta svg { width: 18px; height: 18px; transition: transform 200ms var(--ease-out); }
  .coupon--featured .coupon__value { background: var(--brand-2); color: var(--on-brand-2); }
  /* the notches are a mask, which would clip a box-shadow: shadow the parent */
  .offers--page .coupon { filter: drop-shadow(0 10px 18px rgb(20 16 10 / 0.12)); }
  :global([data-theme='editorial']) .coupon { filter: none !important; }
  :global([data-theme='editorial']) .coupon__link { -webkit-mask: none; mask: none; box-shadow: inset 0 0 0 1.5px var(--ink); }
  .offers__more { margin: 32px 0 0; }
  @media (max-width: 760px) {
    .offers__head { grid-template-columns: 1fr; }
    .coupon__link { --at: 36%; }
  }
</style>
