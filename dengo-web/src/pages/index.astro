---
import { getContent, siteKey, isPreview } from '../core/api'
import { getSite } from '../sites/registry'
import ComingSoon from '../core/ComingSoon.astro'

const content = await getContent()
if (!content) Astro.response.status = 503
const ready = content && (content.published || isPreview(Astro.url) || process.env.WEB_ALLOW_SWITCH === '1')
const Site = getSite(siteKey(Astro, content))
Astro.response.headers.set('Cache-Control', 'public, max-age=60')
---
{ready && content ? <Site.Home content={content} /> : <ComingSoon content={content} />}
