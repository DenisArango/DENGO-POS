---
// "Ingresar": staff and teachers log in from the client's own website.
// Only exists when the client set where to send them (POS → Página web →
// Sitio web → Botón «Ingresar»); otherwise it is a 404.
import { getContent, siteKey, canLogin } from '../core/api'
import { getSite } from '../sites/registry'
import ComingSoon from '../core/ComingSoon.astro'

const content = await getContent()
Astro.response.headers.set('Cache-Control', 'no-store')

// No-JavaScript fallback of the login form: the server asks the backend and
// redirects straight to the POS / portal with the one-time code.
let error: string | null = null
if (Astro.request.method === 'POST' && content && canLogin(content)) {
  const form = await Astro.request.formData()
  const api = (process.env.DENGO_API ?? 'http://127.0.0.1:3001').replace(/\/$/, '')
  try {
    const res = await fetch(`${api}/api/site/login`, {
      method: 'POST',
      headers: { 'content-type': 'application/json', 'x-forwarded-for': Astro.clientAddress ?? '' },
      body: JSON.stringify({ email: String(form.get('email') ?? ''), password: String(form.get('password') ?? '') }),
    })
    const body = await res.json().catch(() => ({}))
    if (res.ok && typeof body.redirect === 'string' && /^https?:\/\//.test(body.redirect)) return Astro.redirect(body.redirect, 303)
    error = body.error ?? 'No se pudo iniciar sesión.'
  } catch {
    error = 'No se pudo iniciar sesión. Intenta de nuevo.'
  }
}

const ok = !!content && canLogin(content)
if (!ok) Astro.response.status = 404
const Site = getSite(siteKey(Astro, content))
---
{ok && content ? <Site.Login content={content} error={error} /> : <ComingSoon content={content} />}
