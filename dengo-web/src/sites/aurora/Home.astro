---
// Librería Aurora — custom design (demo of a made-to-measure site).
// Idea: the shop is the box of crayons and the school notebook every kid
// carries in January. A 3D desk of supplies floats in the hero; the shop's
// story is written in a notebook that turns its pages as you scroll; the
// aisles slide past sideways; a pencil draws the path a coupon takes from
// the phone to the till. Live thing: take your coupon right on the page.
import Layout from './Layout.astro'
import CouponForm from '../../core/CouponForm.astro'
import Stickers from './Stickers.astro'
import { offerHeadline, fmtDay, mapsLink, waLink } from '../../core/api'
import { qrSvg } from '../../core/codes'
import { openState } from '../../core/hours'
import type { SiteContent } from '../../core/types'

const { content } = Astro.props as { content: SiteContent }
const short = content.businessName.replace(/^librer[ií]a\s+/i, '').trim() || content.businessName
const offers = content.promotions.slice(0, 4)
const featured = content.promotions.find(p => p.featured) ?? content.promotions[0]
const wa = waLink(content.contact.whatsapp, `Hola ${content.businessName}, les mando la lista de útiles.`)
const sub = content.heroSubtitle || content.tagline || 'Útiles, cuadernos, arte y oficina. Te armamos la lista del colegio completa.'
const about = (content.about || 'Abrimos la primera tienda con un mostrador, dos estantes y la lista de útiles del colegio de enfrente pegada en la pared.\n\nTodavía trabajamos así: si traes la lista, te la armamos completa.')
  .split(/\n\s*\n|\n/).filter(Boolean)
const towns = content.branches.map(b => b.name.replace(/^(sucursal|tienda|central)\s+/i, ''))
const offerColors = ['var(--yellow)', 'var(--blue)', 'var(--pink)', 'var(--green)']
const offerInk = ['var(--ink)', '#fff', 'var(--ink)', '#fff']

const aisles = [
  { t: 'Cuadernos', x: 'Cosidos, espiral y de dibujo, de 50 a 200 hojas. Te los forramos mientras esperas.', tag: 'En las tres tiendas', img: '/sites/aurora/2000-notebook-pages-4-5.webp', w: 1400, h: 1050, alt: 'Cuaderno cuadriculado abierto con apuntes a mano', c: 'var(--yellow)', i: 'var(--ink)' },
  { t: 'Lápices y colores', x: 'Grafito HB y 2B, colores de 12 a 48, sacapuntas de depósito y borradores de miga.', tag: 'Precio por docena', img: '/sites/aurora/selection-of-colored-pencils.webp', w: 1400, h: 1171, alt: 'Lápices de colores con la punta recién sacada', c: 'var(--red)', i: '#fff' },
  { t: 'Arte', x: 'Témperas, acuarelas, pinceles, plastilina, crayones, carboncillo y papel de colores.', tag: 'Pedidos por grado', img: '/sites/aurora/conte-crayons.webp', w: 1400, h: 1048, alt: 'Crayones y barras de carboncillo en su lata', c: 'var(--blue)', i: '#fff' },
  { t: 'Mochilas', x: 'Para preprimaria, primaria y básicos, con garantía en cierres. Loncheras y cartucheras.', tag: 'Temporada de enero', img: '/sites/aurora/colored-pencils-chevre.webp', w: 1400, h: 1048, alt: 'Lápices de colores acomodados en círculo', c: 'var(--pink)', i: 'var(--ink)' },
  { t: 'Oficina', x: 'Folders, archivadores, papel bond, tinta, engrapadoras y todo para el escritorio.', tag: 'Todo el año', img: '/sites/aurora/apsco-vacuhold-pencil-sharpener-13.webp', w: 1400, h: 933, alt: 'Mecanismo de un sacapuntas de manivela', c: 'var(--green)', i: '#fff' },
]
const marquee1 = ['Cuadernos', 'Crayones', 'Mochilas', 'Témperas', 'Folders', 'Plastilina', 'Acuarelas', 'Sacapuntas']
const marquee2 = ['Te armamos la lista del colegio', 'Forramos tus cuadernos', 'Abrimos temprano']
const sampleQr = qrSvg('CUP-AURORA25', '#120e2e')
const stepCode = featured ? offerHeadline(featured) : '15%'
---
<Layout content={content} home>
  <!-- ═════ HERO: a desk of supplies floating in 3D ═════ -->
  <section class="hero" data-hero aria-labelledby="h-hero">
    <canvas class="hero__canvas" data-desk aria-hidden="true"></canvas>
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="hero__in">
      <h1 id="h-hero" class="hero__title" data-split>
        <span class="hero__l1">Llega a clases</span>
        <span class="hero__l2"><em>con todo.</em><svg class="hero__scrib" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true"><path d="M6 28 C 120 6, 260 6, 380 18 S 560 34, 594 12" /></svg></span>
      </h1>
      <p class="hero__sub" data-hero-in>{sub}</p>
      <div class="hero__actions" data-hero-in>
        {featured && <a class="a-btn a-btn--go" href={`/ofertas/${featured.slug}`} data-magnet data-cursor="Recortar">Recorta tu {offerHeadline(featured)} <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>}
        <a class="a-btn a-btn--light" href="#pasillos" data-magnet>Recorre los pasillos</a>
      </div>
    </div>

    {featured && (
      <a class="badge" href={`/ofertas/${featured.slug}`} data-hero-in aria-label={`${featured.name}: obtener cupón`} data-cursor="Ver">
        <svg class="badge__ring" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="ring" d="M100 100 m -78 0 a 78 78 0 1 1 156 0 a 78 78 0 1 1 -156 0" /></defs>
          <text><textPath href="#ring">REGRESO A CLASES • CUPÓN EN LÍNEA • UNO POR PERSONA • </textPath></text>
        </svg>
        <span class="badge__v">{offerHeadline(featured)}</span>
      </a>
    )}

    {content.branches.length > 0 && (
      <ul class="hero__stores" data-hero-in>
        {content.branches.map(b => { const s = openState(b.openTime, b.closeTime); return (
          <li><span class="live" data-open-flag={s.open ? '1' : '0'} data-store data-open={b.openTime} data-close={b.closeTime}>{b.name.replace(/^(sucursal|tienda)\s+/i, '')}</span></li>
        )})}
      </ul>
    )}
    <span class="hero__scroll" aria-hidden="true"><span></span></span>
  </section>

  <!-- ═════ MARQUEE: two crossing ribbons ═════ -->
  <div class="ribbons" aria-hidden="true">
    <div class="ribbon ribbon--a" data-ribbon>
      <div class="ribbon__track">{[0, 1].map(() => marquee1.map(w => <span>{w}<svg viewBox="0 0 24 24"><path d="M12 0l3 9 9 3-9 3-3 9-3-9-9-3 9-3z" /></svg></span>))}</div>
    </div>
    <div class="ribbon ribbon--b" data-ribbon data-dir="-1">
      <div class="ribbon__track">{[0, 1, 2].map(() => marquee2.map(w => <span>{w}<svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="7" /></svg></span>))}</div>
    </div>
  </div>

  <!-- ═════ OFFERS: stickers you peel off ═════ -->
  {offers.length > 0 && (
    <section class="offers" id="ofertas" aria-labelledby="h-offers">
      <div class="offers__head">
        <h2 id="h-offers" class="h-big" data-split>Ofertas para recortar</h2>
        <div class="cutline" aria-hidden="true" data-cutline>
          <span class="cutline__dash"></span>
          <svg class="cutline__scissors" viewBox="0 0 64 64"><g fill="none" stroke="currentColor" stroke-width="5"><circle cx="14" cy="18" r="9" /><circle cx="14" cy="46" r="9" /></g><path class="blade-a" d="M21 23 60 42" stroke="currentColor" stroke-width="5" stroke-linecap="round" /><path class="blade-b" d="M21 41 60 22" stroke="currentColor" stroke-width="5" stroke-linecap="round" /></svg>
        </div>
        <p class="offers__intro">Pide tu cupón aquí, llega con él en el teléfono y el cajero lo escanea. Uno por persona, en cualquiera de las tiendas.</p>
      </div>
      <Stickers offers={offers} featured={featured} />
      {content.promotions.length > offers.length && <p class="offers__all"><a class="a-btn" href="/ofertas">Ver las {content.promotions.length} ofertas</a></p>}
    </section>
  )}

  <!-- ═════ THE NOTEBOOK: the story, page by page ═════ -->
  <section class="nb" id="cuaderno" aria-labelledby="h-nb">
    <div class="nb__stage" data-nb-stage>
      <h2 id="h-nb" class="h-big nb__title" data-split>El cuaderno de {short}</h2>
      <p class="nb__hint" aria-hidden="true">Sigue bajando para pasar la página</p>
      <div class="book" data-book>
        <div class="page page--base">
          <div class="page__ruled">
            <p class="hand hand--xl">¿Traes tu lista?</p>
            <p class="hand">Mándanos una foto y la tenemos lista cuando llegues. Si algo falta, te avisamos antes.</p>
            {wa && <a class="a-btn a-btn--go page__btn" href={wa} target="_blank" rel="noopener" data-cursor="WhatsApp">Enviar por WhatsApp</a>}
            <p class="hand hand--sign">— el equipo de {short}</p>
          </div>
        </div>
        <div class="leaf" data-leaf>
          <div class="face face--front cover">
            <div class="cover__label">
              <p class="cover__brand">{short}</p>
              <p class="cover__row"><span>Materia</span><b class="hand">Nuestra historia</b></p>
              <p class="cover__row"><span>Nombre</span><b class="hand">{content.businessName}</b></p>
              <p class="cover__row"><span>Grado</span><b class="hand">{content.branches.length || 1} tiendas</b></p>
            </div>
            <span class="cover__elastic" aria-hidden="true"></span>
          </div>
          <div class="face face--back page">
            <div class="page__ruled page__ruled--left">
              <p class="hand hand--xl">Nuestra historia</p>
              <svg class="doodle" viewBox="0 0 220 150" aria-hidden="true"><g fill="none" stroke="var(--blue)" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 140V60l90-45 90 45v80z" /><path d="M20 60h180" /><path d="M85 140V95h50v45" /><path d="M40 80h30v25H40zM150 80h30v25h-30z" /><path d="M60 35l-8-18M160 35l8-18M110 12V2" stroke="var(--red)" /></g></svg>
              <p class="hand">La tienda del dibujo fue la primera. Todavía tiene el mostrador.</p>
            </div>
          </div>
        </div>
        <div class="leaf" data-leaf>
          <div class="face face--front page">
            <div class="page__ruled">
              {about.map((p, i) => <p class:list={['hand', { 'hand--first': i === 0 }]}>{p}</p>)}
            </div>
          </div>
          <div class="face face--back page">
            <div class="page__ruled page__ruled--left">
              <p class="hand hand--xl">Así te armamos la lista</p>
              <ol class="checks">
                <li><span class="box" aria-hidden="true"></span>Traes la lista del colegio, o nos mandas la foto.</li>
                <li><span class="box" aria-hidden="true"></span>La armamos completa, marca por marca.</li>
                <li><span class="box" aria-hidden="true"></span>Forramos los cuadernos mientras esperas.</li>
                <li><span class="box" aria-hidden="true"></span>Si algo falta, te avisamos antes de cobrar.</li>
              </ol>
            </div>
          </div>
        </div>
        <div class="leaf" data-leaf>
          <div class="face face--front page">
            <div class="page__ruled">
              <figure class="polaroid" style="--rot:-4deg">
                <img src="/sites/aurora/selection-of-colored-pencils.webp" alt="Lápices de colores con la punta recién sacada" width="1400" height="1171" loading="lazy" />
                <figcaption class="hand">El pasillo de colores</figcaption>
                <span class="tape" aria-hidden="true"></span>
              </figure>
              <p class="hand">Colores de 12 a 48, siempre con punta.</p>
            </div>
          </div>
          <div class="face face--back page">
            <div class="page__ruled page__ruled--left">
              <figure class="polaroid" style="--rot:3deg">
                <img src="/sites/aurora/2000-notebook-pages-4-5.webp" alt="Cuaderno cuadriculado abierto con apuntes a mano" width="1400" height="1050" loading="lazy" />
                <figcaption class="hand">Cuadernos de 50 a 200 hojas</figcaption>
                <span class="tape" aria-hidden="true"></span>
              </figure>
              <p class="hand">Cosidos, espiral y de dibujo. ¡Y forrados!</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═════ AISLES: slide past sideways ═════ -->
  <section class="aisles" id="pasillos" aria-labelledby="h-aisles">
    <div class="aisles__pin" data-aisles>
      <div class="aisles__track" data-aisles-track>
        <div class="aisle aisle--intro">
          <h2 id="h-aisles" class="h-big">Recorre los pasillos</h2>
          <p class="aisles__lead">{aisles.length} pasillos en cada tienda, desde el cuaderno de preprimaria hasta la tinta de la oficina.</p>
          <svg class="aisles__arrow" viewBox="0 0 120 40" aria-hidden="true"><path d="M2 20h108M92 4l18 16-18 16" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </div>
        {aisles.map((a, i) => (
          <article class="aisle" style={`--c:${a.c}; --i:${a.i}`}>
            <div class="aisle__img"><img src={a.img} alt={a.alt} width={a.w} height={a.h} loading="lazy" data-par /></div>
            <div class="aisle__body">
              <p class="aisle__n">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="aisle__t">{a.t}</h3>
              <p class="aisle__x">{a.x}</p>
              <p class="aisle__tag">{a.tag}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ═════ HOW A COUPON WORKS: a pencil draws the path ═════ -->
  <section class="path" aria-labelledby="h-path">
    <h2 id="h-path" class="h-big path__title" data-split>Del teléfono a la caja</h2>
    <div class="path__body" data-path>
      <svg class="path__svg" aria-hidden="true"><path class="path__line" /></svg>
      <div class="path__pencil" aria-hidden="true"><svg viewBox="0 0 120 24"><path d="M0 4h86v16H0z" fill="var(--red)" /><path d="M0 4h86v5H0z" fill="#ff6a5c" /><path d="M86 4l26 8-26 8z" fill="#e9c393" /><path d="M104 9.5l8 2.5-8 2.5z" fill="var(--ink)" /><path d="M-14 4h14v16h-14z" fill="var(--pink)" /><path d="M-2 4h6v16h-6z" fill="#c9ccd6" /></svg></div>
      <ol class="steps">
        <li class="step" data-step>
          <span class="step__n">1</span>
          <div class="step__card mock-form">
            <span class="mock-form__f">Tu nombre<b class="hand">Ana</b></span>
            <span class="mock-form__f">Tu teléfono<b class="hand">5555 1234</b></span>
            <span class="mock-form__b">Obtener mi cupón</span>
          </div>
          <h3 class="step__t">Elige tu oferta y deja tu nombre</h3>
          <p class="step__x">Sin cuentas ni contraseñas. Solo tu nombre y tu teléfono, para que el cupón sea solo tuyo.</p>
        </li>
        <li class="step" data-step>
          <span class="step__n">2</span>
          <div class="step__card phone">
            <span class="phone__notch" aria-hidden="true"></span>
            <span class="phone__v">{stepCode}</span>
            <span class="phone__qr" set:html={sampleQr} aria-hidden="true"></span>
            <span class="phone__code">AURO-RA25</span>
          </div>
          <h3 class="step__t">Recibes tu cupón con QR</h3>
          <p class="step__x">Queda en tu teléfono. Guárdalo o tómale captura; también puedes dictar el código.</p>
        </li>
        <li class="step" data-step>
          <span class="step__n">3</span>
          <div class="step__card receipt">
            <span class="receipt__h">{content.businessName}</span>
            <span class="receipt__r"><span>Cuaderno cosido ×4</span><span>Q85.00</span></span>
            <span class="receipt__r"><span>Colores 24</span><span>Q42.00</span></span>
            <span class="receipt__r receipt__r--off"><span>Cupón {stepCode}</span><span>−Q12.75</span></span>
            <span class="receipt__t"><span>Total</span><span>Q114.25</span></span>
          </div>
          <h3 class="step__t">En caja, lo escanean y listo</h3>
          <p class="step__x">El descuento se aplica solo. Cada cupón se usa una vez, en cualquiera de las tiendas.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- ═════ THE LIVE THING: clip your coupon here ═════ -->
  {featured && (
    <section class="clip" id="cupon" aria-labelledby="h-clip">
      <h2 id="h-clip" class="h-big clip__title" data-split>Recórtalo aquí mismo</h2>
      <div class="ticket" data-ticket>
        <span class="ticket__sc" aria-hidden="true"><svg viewBox="0 0 64 64"><g fill="none" stroke="currentColor" stroke-width="5"><circle cx="14" cy="18" r="9" /><circle cx="14" cy="46" r="9" /></g><path d="M21 23 60 42M21 41 60 22" stroke="currentColor" stroke-width="5" stroke-linecap="round" /></svg></span>
        <div class="ticket__l">
          <p class="ticket__v">{offerHeadline(featured)}</p>
          <p class="ticket__n">{featured.name}</p>
          <p class="ticket__m">{featured.summary}{featured.endsAt ? ` · hasta el ${fmtDay(featured.endsAt)}` : ''}</p>
        </div>
        <div class="ticket__r">
          <CouponForm slug={featured.slug} formClass="t-form" inputClass="t-input" buttonClass="a-btn a-btn--go t-btn" noteClass="t-note" buttonLabel="Recortar mi cupón" />
        </div>
      </div>
    </section>
  )}

  <!-- ═════ STORES ═════ -->
  {content.branches.length > 0 && (
    <section class="stores" id="tiendas" aria-labelledby="h-stores">
      <h2 id="h-stores" class="h-big" data-split>{towns.length === 1 ? 'Ven a la tienda' : `${towns.length} tiendas, mismo horario`}</h2>
      <ul class="stores__list">
        {content.branches.map((b, i) => { const s = openState(b.openTime, b.closeTime); return (
          <li class="store" style={`--c:${offerColors[(i + 1) % 4]}; --i:${offerInk[(i + 1) % 4]}`} data-store-card>
            <p class="store__n">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="store__t">{b.name}</h3>
            <p class="store__a">{b.address}{b.city ? `, ${b.city}` : ''}</p>
            <p class="store__h">De {b.openTime} a {b.closeTime}, todos los días</p>
            <p class="live store__live" data-open-flag={s.open ? '1' : '0'} data-store data-label data-open={b.openTime} data-close={b.closeTime}>{s.label}</p>
            <p class="store__act">
              <a class="a-btn a-btn--light" href={mapsLink(b)} target="_blank" rel="noopener" data-cursor="Mapa">Cómo llegar</a>
              {b.phone && <a class="store__tel" href={`tel:${b.phone}`}>{b.phone}</a>}
            </p>
          </li>
        )})}
      </ul>
    </section>
  )}
</Layout>

<script>
  import gsap from 'gsap'
  import { ScrollTrigger } from 'gsap/ScrollTrigger'
  import { SplitText } from 'gsap/SplitText'
  import { openState } from '../../core/hours'
  import { mountDesk } from './desk3d'

  gsap.registerPlugin(ScrollTrigger, SplitText)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  const mm = gsap.matchMedia()

  // ── Store open/closed chips, live ─────────────────────────────
  const stores = () => document.querySelectorAll<HTMLElement>('[data-store]').forEach(el => {
    const s = openState(el.dataset.open ?? '', el.dataset.close ?? '')
    el.setAttribute('data-open-flag', s.open ? '1' : '0')
    if (el.hasAttribute('data-label')) el.textContent = s.label
  })
  stores(); setInterval(stores, 30_000)

  // ── Hero: 3D desk + headline ───────────────────────────────────
  const canvas = document.querySelector<HTMLCanvasElement>('[data-desk]')
  const desk = canvas ? mountDesk(canvas, {
    count: innerWidth < 760 ? 22 : 38, still: reduce,
    // keep the space behind the headline clear: left half on wide screens, lower half on phones
    hole: innerWidth >= innerHeight ? (x, y) => x < 0.5 && y > -5 && y < 4.5 : (x, y) => y < -0.5 && y > -7,
  }) : null
  if (!desk) document.querySelector('[data-hero]')?.classList.add('no-3d')

  const heroTitle = document.querySelector<HTMLElement>('.hero__title')!
  const heroIn = document.querySelectorAll<HTMLElement>('[data-hero-in]')
  const scrib = document.querySelector<SVGPathElement>('.hero__scrib path')

  const intro = () => {
    desk?.reveal()
    if (reduce) { gsap.set(heroIn, { opacity: 1 }); return }
    const split = SplitText.create(heroTitle.querySelectorAll('.hero__l1, .hero__l2 em'), { type: 'chars,lines', linesClass: 'a-line', charsClass: 'a-ch' })
    gsap.set(heroTitle, { opacity: 1 })
    const tl = gsap.timeline()
    tl.from(split.chars, { yPercent: 115, rotate: () => gsap.utils.random(-18, 18), duration: 1.1, ease: 'expo.out', stagger: 0.028 })
    if (scrib) { const L = scrib.getTotalLength(); tl.fromTo(scrib, { strokeDasharray: L, strokeDashoffset: L }, { strokeDashoffset: 0, duration: 0.9, ease: 'power2.inOut' }, 0.6) }
    tl.fromTo(heroIn, { opacity: 0, y: 30 }, { opacity: 1, y: 0, duration: 0.9, ease: 'power3.out', stagger: 0.1 }, 0.5)
  }
  if ((window as unknown as { __auroraReady?: boolean }).__auroraReady) intro()
  else addEventListener('aurora:ready', intro, { once: true })

  if (!reduce) {
    // Scrolling out of the hero: the supplies fly past, the title lifts.
    ScrollTrigger.create({ trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true, onUpdate: s => desk?.setProgress(s.progress) })
    gsap.to('.hero__in', { yPercent: -30, opacity: 0.2, ease: 'none', scrollTrigger: { trigger: '[data-hero]', start: 'top top', end: 'bottom top', scrub: true } })
    gsap.to('.badge__ring', { rotate: 360, duration: 18, ease: 'none', repeat: -1 })
  }

  // ── Ribbons: speed follows the scroll ─────────────────────────
  document.querySelectorAll<HTMLElement>('[data-ribbon]').forEach(r => {
    const track = r.querySelector<HTMLElement>('.ribbon__track')!
    const dir = Number(r.dataset.dir ?? 1)
    if (reduce) return
    const loop = gsap.to(track, { xPercent: dir > 0 ? -50 : 0, startAt: { xPercent: dir > 0 ? 0 : -50 }, duration: 28, ease: 'none', repeat: -1 })
    ScrollTrigger.create({
      trigger: r, start: 'top bottom', end: 'bottom top',
      onUpdate: s => {
        const v = s.getVelocity() / 300
        gsap.to(loop, { timeScale: 1 + Math.min(6, Math.abs(v)), duration: 0.2, overwrite: true, onComplete: () => { gsap.to(loop, { timeScale: 1, duration: 1.2 }) } })
        gsap.to(track, { skewX: gsap.utils.clamp(-12, 12, -v * 2 * dir), duration: 0.4, overwrite: 'auto' })
      },
    })
  })

  // ── Section titles: characters rise in ────────────────────────
  if (!reduce) document.querySelectorAll<HTMLElement>('.h-big[data-split]').forEach(h => {
    const split = SplitText.create(h, { type: 'chars,words,lines', linesClass: 'a-line' })
    gsap.from(split.chars, { yPercent: 110, rotate: 8, duration: 0.9, ease: 'expo.out', stagger: 0.018, scrollTrigger: { trigger: h, start: 'top 85%', once: true } })
  })

  // ── Offers: the scissors under the title (stickers: Stickers.astro) ─
  if (!reduce) {
    // Scissors cut along the line under the title as you scroll.
    gsap.fromTo('.cutline__scissors', { left: '0%' }, { left: '100%', ease: 'none', scrollTrigger: { trigger: '[data-cutline]', start: 'top 90%', end: 'top 30%', scrub: 0.5 } })
    gsap.fromTo('.cutline__dash', { clipPath: 'inset(0 0 0 0%)' }, { clipPath: 'inset(0 0 0 100%)', ease: 'none', scrollTrigger: { trigger: '[data-cutline]', start: 'top 90%', end: 'top 30%', scrub: 0.5 } })
    gsap.to('.blade-a', { rotate: 14, svgOrigin: '21 32', duration: 0.18, repeat: -1, yoyo: true, ease: 'sine.inOut' })
    gsap.to('.blade-b', { rotate: -14, svgOrigin: '21 32', duration: 0.18, repeat: -1, yoyo: true, ease: 'sine.inOut' })
  }

  // ── The notebook turns its pages ──────────────────────────────
  const book = document.querySelector<HTMLElement>('[data-book]')
  if (book && !reduce) {
    book.classList.add('is-3d')
    const leaves = [...book.querySelectorAll<HTMLElement>('[data-leaf]')]
    const n = leaves.length
    const stack = () => leaves.forEach((l, i) => {
      const rot = Number(gsap.getProperty(l, 'rotateY'))
      l.style.zIndex = String(rot < -90 ? 10 + i : 10 + n - i)
    })
    mm.add({ wide: '(min-width: 861px)', narrow: '(max-width: 860px)' }, ctx => {
      const wide = ctx.conditions?.wide
      gsap.set(book, { xPercent: 0, rotateX: 10 })
      const tl = gsap.timeline({
        scrollTrigger: { trigger: '[data-nb-stage]', start: 'top top', end: `+=${n * 90 + 40}%`, pin: true, scrub: 0.7, anticipatePin: 1 },
        onUpdate: stack,
      })
      tl.to('.nb__hint', { opacity: 0, duration: 0.3 }, 0)
      if (wide) tl.to(book, { xPercent: 50, duration: 1, ease: 'power2.inOut' }, 0)
      tl.to(book, { rotateX: 4, duration: n * 1.2 }, 0)
      leaves.forEach((l, i) => {
        tl.to(l, { rotateY: -180, duration: 1, ease: 'power2.inOut' }, i * 1.2)
        if (!wide) tl.to(l, { opacity: 0, duration: 0.25 }, i * 1.2 + 0.75)
      })
      // tick the checkboxes when their page is showing
      tl.to('.checks .box', { '--tick': 1, stagger: 0.15, duration: 0.2 }, 1.9)
      stack()
      return () => { gsap.set([book, ...leaves], { clearProps: 'all' }) }
    })
  }

  // ── Aisles: pinned sideways scroll on wide screens ────────────
  mm.add('(min-width: 861px) and (prefers-reduced-motion: no-preference)', () => {
    const track = document.querySelector<HTMLElement>('[data-aisles-track]')!
    const dist = () => track.scrollWidth - innerWidth
    const tween = gsap.to(track, { x: () => -dist(), ease: 'none', scrollTrigger: { trigger: '[data-aisles]', start: 'top top', end: () => `+=${dist()}`, pin: true, scrub: 0.8, invalidateOnRefresh: true } })
    track.querySelectorAll<HTMLElement>('.aisle:not(.aisle--intro)').forEach((card, i) => {
      gsap.fromTo(card, { rotate: i % 2 ? 6 : -6, y: 60 }, { rotate: i % 2 ? 1.5 : -1.5, y: 0, ease: 'none', scrollTrigger: { trigger: card, containerAnimation: tween, start: 'left right', end: 'center center', scrub: true } })
      const img = card.querySelector('[data-par]')
      if (img) gsap.fromTo(img, { xPercent: -12, scale: 1.25 }, { xPercent: 12, scale: 1.1, ease: 'none', scrollTrigger: { trigger: card, containerAnimation: tween, start: 'left right', end: 'right left', scrub: true } })
    })
    gsap.to('.aisles__arrow', { x: 24, duration: 0.7, repeat: -1, yoyo: true, ease: 'sine.inOut' })
  })

  // ── The pencil draws the coupon's path ────────────────────────
  const pathBox = document.querySelector<HTMLElement>('[data-path]')
  if (pathBox) {
    const svg = pathBox.querySelector<SVGSVGElement>('.path__svg')!
    const line = svg.querySelector<SVGPathElement>('.path__line')!
    const pencil = pathBox.querySelector<HTMLElement>('.path__pencil')!
    const steps = [...pathBox.querySelectorAll<HTMLElement>('[data-step]')]
    let L = 0
    let st: ScrollTrigger | null = null
    const build = () => {
      const box = pathBox.getBoundingClientRect()
      const w = box.width, h = box.height
      svg.setAttribute('viewBox', `0 0 ${w} ${h}`)
      // Through the number badge of every step, swinging between them.
      const pts = [{ x: w * 0.5, y: 0 }, ...steps.map(s => {
        const b = s.querySelector<HTMLElement>('.step__n')!.getBoundingClientRect()
        return { x: b.left - box.left + b.width / 2, y: b.top - box.top + b.height / 2 }
      }), { x: w * 0.5, y: h }]
      let d = `M${pts[0]!.x} ${pts[0]!.y}`
      for (let i = 1; i < pts.length; i++) {
        const a = pts[i - 1]!, b = pts[i]!
        const swing = (i % 2 ? 1 : -1) * Math.min(w * 0.35, 260)
        d += ` C ${a.x + swing} ${a.y + (b.y - a.y) * 0.35}, ${b.x - swing} ${a.y + (b.y - a.y) * 0.65}, ${b.x} ${b.y}`
      }
      line.setAttribute('d', d)
      L = line.getTotalLength()
      line.style.strokeDasharray = `${L}`
      if (!st) line.style.strokeDashoffset = reduce ? '0' : `${L}`
    }
    const place = (p: number) => {
      line.style.strokeDashoffset = `${L * (1 - p)}`
      const at = Math.max(0.5, L * p)
      const a = line.getPointAtLength(at), b = line.getPointAtLength(Math.max(0, at - 2))
      const ang = Math.atan2(a.y - b.y, a.x - b.x) * 180 / Math.PI
      pencil.style.transform = `translate(${a.x}px, ${a.y}px) rotate(${ang}deg)`
      steps.forEach((s, i) => s.classList.toggle('on', p >= (i + 0.6) / (steps.length + 1) - 0.08))
    }
    build()
    if (reduce) { steps.forEach(s => s.classList.add('on')); pencil.style.display = 'none' }
    else {
      st = ScrollTrigger.create({ trigger: pathBox, start: 'top 70%', end: 'bottom 70%', scrub: 0.6, onUpdate: s => place(s.progress), onRefresh: s => { build(); place(s.progress) } })
      place(0)
    }
  }

  // ── Ticket + stores entrances ─────────────────────────────────
  if (!reduce) {
    gsap.from('[data-ticket]', { y: 120, rotate: -6, scale: 0.92, duration: 1.2, ease: 'elastic.out(1, 0.6)', scrollTrigger: { trigger: '[data-ticket]', start: 'top 85%', once: true } })
    gsap.to('.ticket__sc', { left: 'calc(100% - 40px)', duration: 3.2, ease: 'sine.inOut', repeat: -1, yoyo: true })
    gsap.from('[data-store-card]', { y: 140, rotate: (i: number) => [-8, 5, -4][i % 3], opacity: 0, duration: 1, ease: 'back.out(1.6)', stagger: 0.12, scrollTrigger: { trigger: '.stores__list', start: 'top 80%', once: true } })
  }
</script>

