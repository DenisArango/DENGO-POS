---
import '@fontsource-variable/bricolage-grotesque/standard.css'
import '@fontsource/caveat/500.css'
import '@fontsource/caveat/700.css'
import './aurora.css'
import Seo from '../../core/Seo.astro'
import { waLink, canLogin } from '../../core/api'
import { openState } from '../../core/hours'
import type { SiteContent } from '../../core/types'

interface Props { content: SiteContent; title?: string; description?: string; noindex?: boolean; home?: boolean; dark?: boolean; yellow?: boolean; foot?: boolean }
// home/dark: the page opens on a dark field, so the header starts light.
// yellow: it opens on the yellow field, so the yellow button turns red there.
const { content, title, description, noindex, home, dark, yellow, foot = true } = Astro.props
const login = canLogin(content)
const wa = waLink(content.contact.whatsapp, `Hola ${content.businessName}, vi su página y quiero información.`)
const short = content.businessName.replace(/^librer[ií]a\s+/i, '').trim() || content.businessName
const main = content.branches[0]
const st = main ? openState(main.openTime, main.closeTime) : null
const year = new Date().getFullYear()
const crayons = ['var(--yellow)', 'var(--red)', 'var(--blue)', 'var(--green)', 'var(--pink)']
const first = content.promotions.find(p => p.featured) ?? content.promotions[0]
---
<!doctype html>
<html lang="es" data-site="aurora">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#120e2e" />
    <Seo content={content} title={title} description={description} noindex={noindex} />
    <script is:inline>
      document.documentElement.classList.add('a-js')
      try {
        if (!sessionStorage.getItem('aurora-pre') && !matchMedia('(prefers-reduced-motion: reduce)').matches && location.pathname === '/') document.documentElement.classList.add('a-pre')
      } catch (e) {}
    </script>
  </head>
  <body>
    <!-- Preloader: first visit of the session only. -->
    <div class="pre" aria-hidden="true">
      <div class="pre__in">
        <svg class="pre__scribble" viewBox="0 0 600 160" fill="none"><path d="M10 120 C 60 20, 110 20, 130 90 S 200 150, 230 70 S 300 10, 330 90 S 420 150, 450 60 S 540 30, 590 100" stroke="currentColor" stroke-width="14" stroke-linecap="round" /></svg>
        <p class="pre__word">{short.split('').map(ch => <span>{ch}</span>)}</p>
        <p class="pre__count"><span data-pre-count>0</span>%</p>
      </div>
    </div>

    <!-- Reading progress: a pencil that grows as you scroll. -->
    <div class="pencil-bar" aria-hidden="true"><span class="pencil-bar__body"></span><span class="pencil-bar__tip"></span></div>

    <div class="cursor" aria-hidden="true"><span class="cursor__label"></span></div>

    <header class:list={['a-top', { 'is-home': home || dark, 'on-yellow': yellow }]} data-top>
      <a class="a-logo" href="/" aria-label={`${content.businessName}, inicio`} data-magnet>
        <span class="a-logo__mark"><svg viewBox="0 0 40 40" aria-hidden="true"><path d="M8 32 28 12l4 4-20 20H8z" fill="var(--yellow)" /><path d="M28 12l4-4 4 4-4 4z" fill="var(--pink)" /><path d="M8 32v4h4z" fill="var(--ink)" /></svg></span>
        <span class="a-logo__t">{short}</span>
      </a>
      <nav class="a-links" aria-label="Principal">
        <a href="/#ofertas">Ofertas</a>
        <a href="/#cuaderno">Historia</a>
        <a href="/#pasillos">Pasillos</a>
        <a href="/#tiendas">Tiendas</a>
      </nav>
      <div class="a-top__end">
        {login && (
          <a class="a-in" href="/ingresar" data-magnet aria-label="Ingresar (equipo y maestros)">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="4" /><path d="M4 21c1.5-4 4.5-6 8-6s6.5 2 8 6" /></svg>
            <span>Ingresar</span>
          </a>
        )}
        <a class="a-btn a-btn--yellow a-top__cta" href={first ? `/ofertas/${first.slug}` : (wa ?? '/#tiendas')} data-magnet data-cursor="Cupón">{first ? 'Obtener cupón' : 'Escríbenos'}</a>
      </div>
    </header>

    <div class="a-main"><main><slot /></main></div>

    {foot && <footer class="a-foot" id="contacto">
      <div class="foot__top">
        <div class="foot__col">
          <p class="foot__big">¿Ya tienes la lista del colegio?</p>
          {wa && <a class="a-btn a-btn--yellow" href={wa} target="_blank" rel="noopener" data-magnet data-cursor="WhatsApp">Mándanos una foto por WhatsApp <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M5 12h14M13 6l6 6-6 6" /></svg></a>}
        </div>
        <nav class="foot__col foot__nav" aria-label="Pie de página">
          <a href="/ofertas">Todas las ofertas</a>
          <a href="/#cuaderno">Nuestra historia</a>
          <a href="/#pasillos">Pasillos</a>
          <a href="/#tiendas">Tiendas y horarios</a>
          {content.contact.facebook && <a href={content.contact.facebook} target="_blank" rel="noopener">Facebook</a>}
          {content.contact.instagram && <a href={content.contact.instagram} target="_blank" rel="noopener">Instagram</a>}
          {login && <a href="/ingresar">Ingresar (equipo y maestros)</a>}
        </nav>
        <div class="foot__col">
          {main && <>
            <p class="foot__label">Hora en Guatemala</p>
            <p class="foot__clock" data-gt-clock>--:--</p>
            <p class="live" data-gt-state data-open={main.openTime} data-close={main.closeTime} data-open-flag={st?.open ? '1' : '0'}>{st?.label}</p>
          </>}
          {content.contact.email && <a class="foot__mail" href={`mailto:${content.contact.email}`}>{content.contact.email}</a>}
          {content.contact.phone && <a class="foot__mail" href={`tel:${content.contact.phone}`}>{content.contact.phone}</a>}
        </div>
      </div>
      <p class="foot__word" aria-hidden="true" data-word>
        {short.split('').map((ch, i) => <span style={`--c:${crayons[i % crayons.length]}; --i:${i}`}>{ch}</span>)}
      </p>
      <div class="foot__base">
        <small>© {year} {content.businessName}</small>
        <small>Fotos: Wikimedia Commons — lápices por Chevre y por B. Esham, crayones por Just plain Bill, sacapuntas (CC BY-SA 3.0), cuaderno por Tobin (CC BY-SA 2.0).</small>
      </div>
    </footer>}

    <script>
      import gsap from 'gsap'
      import { ScrollTrigger } from 'gsap/ScrollTrigger'
      import { openState } from '../../core/hours'

      gsap.registerPlugin(ScrollTrigger)
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches
      const root = document.documentElement

      // ── Preloader ────────────────────────────────────────────────
      const ready = () => window.dispatchEvent(new Event('aurora:ready'))
      ;(window as unknown as { __auroraReady?: boolean }).__auroraReady = false
      const markReady = () => { (window as unknown as { __auroraReady?: boolean }).__auroraReady = true; ready() }
      if (root.classList.contains('a-pre')) {
        const count = document.querySelector<HTMLElement>('[data-pre-count]')!
        const path = document.querySelector<SVGPathElement>('.pre__scribble path')!
        const len = path.getTotalLength()
        gsap.set(path, { strokeDasharray: len, strokeDashoffset: len })
        const n = { v: 0 }
        const tl = gsap.timeline({ onComplete: () => { root.classList.remove('a-pre'); try { sessionStorage.setItem('aurora-pre', '1') } catch {} } })
        tl.from('.pre__word span', { yPercent: 120, rotate: 12, stagger: 0.05, duration: 0.7, ease: 'back.out(2)' }, 0)
          .to(path, { strokeDashoffset: 0, duration: 1.1, ease: 'power2.inOut' }, 0)
          .to(n, { v: 100, duration: 1.1, ease: 'power2.inOut', onUpdate: () => { count.textContent = String(Math.round(n.v)) } }, 0)
          .to('.pre__in', { yPercent: -30, opacity: 0, duration: 0.5, ease: 'power2.in' }, 1.2)
          .to('.pre', { clipPath: 'inset(0 0 100% 0)', duration: 0.8, ease: 'expo.inOut', onStart: markReady }, 1.35)
      } else {
        requestAnimationFrame(markReady)
      }

      // ── Header: hides going down, comes back going up ────────────
      const top = document.querySelector<HTMLElement>('[data-top]')!
      let lastY = scrollY
      addEventListener('scroll', () => {
        const y = scrollY
        top.classList.toggle('is-scrolled', y > 40)
        top.classList.toggle('is-hidden', y > 400 && y > lastY + 4)
        if (y < lastY - 4) top.classList.remove('is-hidden')
        lastY = y
      }, { passive: true })

      // ── Pencil progress bar ──────────────────────────────────────
      const body = document.querySelector<HTMLElement>('.pencil-bar__body')!
      const tip = document.querySelector<HTMLElement>('.pencil-bar__tip')!
      const setBar = () => {
        const max = document.documentElement.scrollHeight - innerHeight
        const p = max > 0 ? Math.min(1, scrollY / max) : 0
        body.style.transform = `scaleX(${p})`
        tip.style.transform = `translateX(${p * (innerWidth - 2)}px)`
      }
      addEventListener('scroll', setBar, { passive: true }); addEventListener('resize', setBar); setBar()

      // ── Cursor + magnetic buttons (mouse only) ───────────────────
      if (fine && !reduce) {
        const cur = document.querySelector<HTMLElement>('.cursor')!
        const label = cur.querySelector<HTMLElement>('.cursor__label')!
        const xTo = gsap.quickTo(cur, 'x', { duration: 0.45, ease: 'power3' })
        const yTo = gsap.quickTo(cur, 'y', { duration: 0.45, ease: 'power3' })
        addEventListener('pointermove', e => { xTo(e.clientX); yTo(e.clientY); cur.classList.add('on') }, { passive: true })
        document.addEventListener('pointerleave', () => cur.classList.remove('on'))
        document.addEventListener('pointerover', e => {
          const t = (e.target as HTMLElement).closest<HTMLElement>('[data-cursor], a, button')
          cur.classList.toggle('big', !!t?.dataset.cursor)
          cur.classList.toggle('link', !!t && !t.dataset.cursor)
          label.textContent = t?.dataset.cursor ?? ''
        })
        document.querySelectorAll<HTMLElement>('[data-magnet]').forEach(el => {
          const mx = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'elastic.out(1, 0.4)' })
          const my = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'elastic.out(1, 0.4)' })
          el.addEventListener('pointermove', e => {
            const r = el.getBoundingClientRect()
            mx((e.clientX - r.left - r.width / 2) * 0.3); my((e.clientY - r.top - r.height / 2) * 0.4)
          })
          el.addEventListener('pointerleave', () => { mx(0); my(0) })
        })
      }

      // ── Generic entrances ────────────────────────────────────────
      document.querySelectorAll<HTMLElement>('[data-group]').forEach(group => {
        const parts = group.querySelectorAll<HTMLElement>('[data-in]')
        if (!parts.length) return
        if (reduce) { gsap.set(parts, { opacity: 1 }); return }
        gsap.fromTo(parts, { opacity: 0, y: 40, rotate: 1.5 }, {
          opacity: 1, y: 0, rotate: 0, duration: 0.9, ease: 'power4.out', stagger: 0.08,
          scrollTrigger: { trigger: group, start: 'top 85%', once: true },
        })
      })

      // ── Footer: the shop's name, one crayon per letter ───────────
      if (!reduce && document.querySelector('[data-word]')) {
        gsap.from('[data-word] span', {
          yPercent: 100, rotate: () => gsap.utils.random(-25, 25), stagger: 0.06, duration: 1, ease: 'back.out(1.8)',
          scrollTrigger: { trigger: '[data-word]', start: 'top 95%', once: true },
        })
        document.querySelectorAll<HTMLElement>('[data-word] span').forEach(s => {
          s.addEventListener('pointerenter', () => gsap.fromTo(s, { y: 0 }, { y: '-0.18em', rotate: gsap.utils.random(-14, 14), duration: 0.25, ease: 'power2.out', yoyo: true, repeat: 1 }))
        })
      }

      // ── Live clock + open/closed in Guatemala time ───────────────
      const clock = document.querySelector<HTMLElement>('[data-gt-clock]')
      const state = document.querySelector<HTMLElement>('[data-gt-state]')
      const tick = () => {
        if (clock) clock.textContent = new Date().toLocaleTimeString('es-GT', { timeZone: 'America/Guatemala', hour: '2-digit', minute: '2-digit', hour12: false })
        if (state) { const s = openState(state.dataset.open ?? '', state.dataset.close ?? ''); state.textContent = s.label; state.setAttribute('data-open-flag', s.open ? '1' : '0') }
      }
      tick(); setInterval(tick, 20_000)

      document.fonts?.ready.then(() => ScrollTrigger.refresh())
    </script>

    <style>
      /* Preloader */
      .pre { display: none; }
      :global(.a-pre) .pre { display: grid; position: fixed; inset: 0; z-index: 100; background: var(--yellow); color: var(--ink); place-items: center; clip-path: inset(0 0 0 0); }
      :global(.a-pre) body { overflow: hidden; }
      .pre__in { display: grid; justify-items: center; gap: 8px; position: relative; }
      .pre__scribble { position: absolute; width: min(90vw, 760px); color: var(--red); top: 50%; left: 50%; translate: -50% -50%; opacity: 0.9; }
      .pre__word { position: relative; font-size: clamp(4rem, 16vw, 13rem); font-weight: 800; letter-spacing: -0.06em; line-height: 0.9; overflow: clip; display: flex; }
      .pre__word span { display: inline-block; }
      .pre__count { position: relative; font-size: 1.25rem; font-weight: 700; font-variant-numeric: tabular-nums; }

      /* Pencil progress */
      .pencil-bar { position: fixed; left: 0; right: 0; top: 0; height: 8px; z-index: 60; pointer-events: none; }
      .pencil-bar__body { position: absolute; inset: 0; background: repeating-linear-gradient(90deg, var(--yellow) 0 40px, #f1b400 40px 42px); transform: scaleX(0); transform-origin: left; }
      .pencil-bar__tip { position: absolute; left: -2px; top: 0; width: 0; height: 0; border-top: 4px solid transparent; border-bottom: 4px solid transparent; border-left: 14px solid #e8c79a; }
      .pencil-bar__tip::after { content: ''; position: absolute; left: -5px; top: -2px; border-top: 2px solid transparent; border-bottom: 2px solid transparent; border-left: 5px solid var(--ink); transform: translateX(8px); }

      /* Cursor */
      .cursor { position: fixed; left: 0; top: 0; z-index: 90; width: 0; height: 0; pointer-events: none; }
      .cursor::before { content: ''; position: absolute; width: 18px; height: 18px; left: -9px; top: -9px; border-radius: 50%; background: var(--yellow); mix-blend-mode: difference; opacity: 0; transform: scale(0.4); transition: transform 300ms var(--ease-out), opacity 200ms ease; }
      .cursor.on::before { opacity: 1; transform: scale(1); }
      .cursor.link::before { transform: scale(2.4); }
      .cursor.big::before { transform: scale(5.5); mix-blend-mode: normal; background: var(--red); }
      .cursor__label { position: absolute; transform: translate(-50%, -50%); color: #fff; font-weight: 800; font-size: 0.875rem; white-space: nowrap; opacity: 0; transition: opacity 200ms ease; }
      .cursor.big .cursor__label { opacity: 1; }
      @media not ((hover: hover) and (pointer: fine)) { .cursor { display: none; } }

      /* Header */
      .a-top { position: fixed; top: 14px; left: var(--m); right: var(--m); z-index: 50; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 8px 8px 8px 10px; border-radius: 999px; transition: transform 500ms var(--ease-out), background-color 300ms ease, box-shadow 300ms ease; }
      .a-top.is-scrolled { background: rgb(255 250 240 / 0.86); -webkit-backdrop-filter: blur(14px); backdrop-filter: blur(14px); box-shadow: 0 10px 30px -12px rgb(18 14 46 / 0.35); }
      .a-top.is-hidden { transform: translateY(-140%); }
      .a-logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; justify-self: start; color: var(--ink); transition: color 300ms ease; }
      .a-logo__mark { width: 46px; height: 46px; border-radius: 50%; background: var(--ink); display: grid; place-items: center; border: 2px solid var(--paper); }
      .a-logo__mark svg { width: 28px; }
      .a-logo__t { font-weight: 800; font-size: 1.5rem; letter-spacing: -0.04em; }
      .a-links { display: flex; gap: 6px; padding: 6px; border-radius: 999px; background: rgb(18 14 46 / 0.06); }
      .a-links a { text-decoration: none; font-weight: 600; padding: 10px 16px; border-radius: 999px; color: var(--ink); transition: background-color 200ms ease, color 200ms ease; }
      .a-top.is-home:not(.is-scrolled) .a-logo, .a-top.is-home:not(.is-scrolled) .a-links a { color: var(--paper); }
      .a-top.is-home:not(.is-scrolled) .a-links { background: rgb(255 250 240 / 0.12); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      @media (hover: hover) { .a-links a:hover { background: var(--yellow); color: var(--ink); } }
      .a-top.is-scrolled .a-links { background: transparent; }
      .a-top__end { justify-self: end; display: flex; align-items: center; gap: 8px; }
      .a-top__cta { min-height: 50px; }
      .a-top.on-yellow:not(.is-scrolled) .a-top__cta { --b: var(--red); --f: #fff; --s: var(--ink); }
      .a-top.on-yellow:not(.is-scrolled) .a-links, .a-top.on-yellow:not(.is-scrolled) .a-in { background: rgb(18 14 46 / 0.08); }
      .a-in { display: inline-flex; align-items: center; gap: 8px; min-height: 50px; padding: 0 18px 0 14px; border-radius: 999px; text-decoration: none; font-weight: 700; color: var(--ink); background: rgb(18 14 46 / 0.06); transition: background-color 200ms ease, color 200ms ease; -webkit-tap-highlight-color: transparent; }
      .a-in svg { width: 22px; height: 22px; }
      .a-in:active { transform: scale(0.96); }
      .a-top.is-home:not(.is-scrolled) .a-in { color: var(--paper); background: rgb(255 250 240 / 0.12); -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px); }
      @media (hover: hover) { .a-in:hover { background: var(--paper); color: var(--ink) !important; } }
      @media (max-width: 860px) {
        .a-top { grid-template-columns: auto 1fr; } .a-links { display: none; } .a-top__cta { min-height: 46px; padding: 0 18px; }
        .a-in { width: 46px; min-height: 46px; padding: 0; justify-content: center; } .a-in span { display: none; }
      }

      /* Footer */
      .a-foot { background: var(--ink); color: var(--paper); padding: clamp(64px, 9vw, 140px) var(--m) 24px; overflow: hidden; }
      .foot__top { display: grid; grid-template-columns: 1.4fr 1fr 1fr; gap: clamp(28px, 4vw, 64px); }
      .foot__col { display: grid; gap: 18px; align-content: start; justify-items: start; }
      .foot__big { font-size: clamp(2rem, 1.2rem + 3vw, 3.75rem); font-weight: 800; letter-spacing: -0.04em; line-height: 1; max-width: 14ch; }
      .foot__nav a { text-decoration: none; font-size: 1.25rem; font-weight: 600; background: linear-gradient(var(--yellow), var(--yellow)) left bottom / 0 3px no-repeat; transition: background-size 300ms var(--ease-out); }
      .foot__nav { gap: 10px; }
      @media (hover: hover) { .foot__nav a:hover { background-size: 100% 3px; } }
      .foot__label { color: rgb(255 250 240 / 0.7); font-size: var(--step-small); }
      .foot__clock { font-size: clamp(3rem, 2rem + 3vw, 5rem); font-weight: 800; letter-spacing: -0.05em; line-height: 0.9; font-variant-numeric: tabular-nums; color: var(--yellow); }
      .foot__mail { font-weight: 600; text-decoration: none; }
      .foot__word { display: flex; justify-content: center; margin: clamp(40px, 6vw, 90px) 0 0; font-size: clamp(5rem, 24vw, 30rem); font-weight: 800; letter-spacing: -0.07em; line-height: 0.78; max-width: none; overflow: clip; padding-bottom: 0.04em; }
      .foot__word span { display: inline-block; color: var(--c); cursor: default; }
      .foot__base { display: flex; justify-content: space-between; gap: 24px; flex-wrap: wrap; border-top: 2px solid rgb(255 250 240 / 0.14); padding-top: 18px; margin-top: 18px; color: rgb(255 250 240 / 0.72); }
      .foot__base small { font-size: var(--step-small); max-width: 80ch; }
      @media (max-width: 860px) { .foot__top { grid-template-columns: 1fr 1fr; } .foot__top > :first-child { grid-column: 1 / -1; } }
    </style>
  </body>
</html>
