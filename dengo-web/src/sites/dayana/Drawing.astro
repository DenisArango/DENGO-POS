      ['n', 'M214 262 V172 H372 V262'], ['r', 'M204 172 L293 126 L382 172'], ['o', 'M278 262 V220 H308 V262'], ['s', 'M228 188 h32 v26 h-32 z M326 188 h32 v26 h-32 z'],
