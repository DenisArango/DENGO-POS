}
const d = D[n] ?? D[1]!
---
<svg class:list={['dw', cls]} viewBox="0 0 400 300" data-draw aria-hidden="true" focusable="false">
  <g class="dw-art">
    <g class="dw-fills">{d.f.map(([c, p]) => <path class="dw-fl" d={p} fill={`url(#hx-${c})`} />)}</g>
    <g class="dw-lines">{d.s.map(([c, p, w]) => <path class={`dw-ln c-${c}`} d={p} style={w ? `stroke-width:${w}` : undefined} />)}</g>
    <g class="dw-words">{d.w.map(([c, x, y, t, size = 22, rot = 0]) => <text class={`dw-w c-${c}`} x={x} y={y} text-anchor="middle" style={`font-size:${size}px`} transform={rot ? `rotate(${rot} ${x} ${y})` : undefined}>{t}</text>)}</g>
  </g>
  <g class="dw-tip" opacity="0"><g transform="rotate(-38)"><path d="M0 0 L-7 -16 H7 Z" class="dw-tip__wax" /><rect x="-7.5" y="-58" width="15" height="43" rx="2.5" class="dw-tip__wrap" /><path d="M-7.5 -48 h15 M-7.5 -24 h15" class="dw-tip__band" /></g></g>
</svg>

<style>
  .dw { width: 100%; height: auto; overflow: visible; }
  .dw-art { filter: url(#wax); }
  .dw-ln { fill: none; stroke-width: 4.5; stroke-linecap: round; stroke-linejoin: round; }
  .dw-fl { opacity: 0.85; }
  .dw-w { font-family: 'Caveat', 'Comic Sans MS', cursive; font-weight: 700; stroke: none !important; }
  .c-r { stroke: #e8141c; fill: #e8141c; --c: #e8141c; }
  .c-n { stroke: #173a9e; fill: #173a9e; --c: #173a9e; }
  .c-y { stroke: #f0a800; fill: #f0a800; --c: #f0a800; }
  .c-g { stroke: #12a356; fill: #12a356; --c: #12a356; }
  .c-s { stroke: #2b9be0; fill: #2b9be0; --c: #2b9be0; }
  .c-o { stroke: #ff7a1a; fill: #ff7a1a; --c: #ff7a1a; }
  .c-b { stroke: #9a5b2e; fill: #9a5b2e; --c: #9a5b2e; }
  .c-k { stroke: #1a1433; fill: #1a1433; --c: #1a1433; }
  .dw-ln.c-r, .dw-ln.c-n, .dw-ln.c-y, .dw-ln.c-g, .dw-ln.c-s, .dw-ln.c-o, .dw-ln.c-b, .dw-ln.c-k { fill: none; }
  .dw-tip__wax { fill: var(--tip, #e8141c); stroke: #1a1433; stroke-width: 2; stroke-linejoin: round; }
  .dw-tip__wrap { fill: var(--tip, #e8141c); stroke: #1a1433; stroke-width: 2; }
  .dw-tip__band { stroke: #1a1433; stroke-width: 2.5; opacity: 0.5; }
  /* Waiting to be drawn (the script adds .is-pending, then draws). */
  :global(.is-pending) .dw-ln { stroke-dasharray: var(--len) var(--len); stroke-dashoffset: var(--len); }
  :global(.is-pending) .dw-fl, :global(.is-pending) .dw-w { opacity: 0; }
</style>
