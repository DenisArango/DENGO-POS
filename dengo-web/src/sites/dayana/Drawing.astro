---
// A crayon drawing of the house at one stage of the story. Strokes are drawn
// in order by the page script (a crayon tip follows the line), then the
// fills and the handwritten words fade in. Without script, or with reduced
// motion, it shows finished. The wax filter and hatch fills are defined once
// on the page (Home.astro, #wax and #hx-*).
interface Props { n: number; class?: string }
const { n, class: cls = '' } = Astro.props

type C = 'r' | 'n' | 'y' | 'g' | 's' | 'o' | 'b' | 'k'
type Stroke = [C, string, number?]
type Fill = [C, string]
type Word = [C, number, number, string, number?, number?]

const GROUND = 'M14 264 C 110 256, 260 270, 388 260'
const D: Record<number, { s: Stroke[]; f: Fill[]; w: Word[] }> = {
