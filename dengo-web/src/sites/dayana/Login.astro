---
// "Ingresar" — Dayana's entry pass. The supplies float in 3D over the navy
// night (the home page's scene, without its 3D crew); the pass drops on a red
// strap and swings with the pointer, Roja and Azul stand by it, it shakes on
// a wrong password and gets stamped «¡Adelante!» before flying off to the POS
// or the teachers' portal.
import Layout from './Layout.astro'
import LoginForm from '../../core/LoginForm.astro'
import Crayon from './Crayon.astro'
import { BRAND } from './data'
import type { SiteContent } from '../../core/types'

const { content, error } = Astro.props as { content: SiteContent; error?: string | null }
const teachers = !!content.access?.teachers
const staff = !!content.access?.staff
const year = new Date().getFullYear()
---
<Layout content={content} title="Ingresar" description="Acceso para el equipo y los maestros." noindex dark credits={false}>
  <section class="gate" data-gate aria-labelledby="h-gate">
    <canvas class="gate__canvas" data-desk aria-hidden="true"></canvas>
    <div class="gate__glow" aria-hidden="true"></div>

    <div class="gate__copy">
      <p class="gate__hand dy-hand" data-gate-in>{teachers && staff ? 'Para el equipo y los maestros' : teachers ? 'Para los maestros' : 'Para el equipo'}</p>
      <h1 id="h-gate" class="gate__title" data-gate-title>
        <span class="gate__l">Pasa</span>
        <span class="gate__l gate__l--2"><em>adelante.</em><svg class="gate__scrib" viewBox="0 0 600 40" preserveAspectRatio="none" aria-hidden="true"><path d="M6 26 C 140 4, 300 10, 420 20 S 560 30, 594 10" /></svg></span>
      </h1>
      <p class="gate__sub" data-gate-in>Entra con tu correo y tu contraseña. Según tu usuario, te llevamos directo a donde te toca.</p>
      <ul class="doors" data-gate-in>
        {staff && (
          <li class="door" style="--c: var(--yellow); --i: var(--ink)">
            <svg viewBox="0 0 32 32" aria-hidden="true"><rect x="4" y="9" width="24" height="17" rx="3" fill="none" stroke="currentColor" stroke-width="2.6" /><path d="M10 9V6h12v3M4 15h24" fill="none" stroke="currentColor" stroke-width="2.6" /></svg>
            <span><b>Equipo de la tienda</b>Caja, inventario y reportes</span>
          </li>
        )}
        {teachers && (
          <li class="door" style="--c: var(--pink); --i: var(--ink)">
            <svg viewBox="0 0 32 32" aria-hidden="true"><path d="M4 7h10a3 3 0 0 1 3 3v16a3 3 0 0 0-3-3H4zM28 7H18a3 3 0 0 0-3 3v16a3 3 0 0 1 3-3h10z" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linejoin="round" /></svg>
            <span><b>Maestros</b>Pedidos de útiles</span>
          </li>
        )}
      </ul>
    </div>

    <div class="lanyard" data-lanyard>
      <span class="strap" aria-hidden="true"><span>Dayana · Dayana · Dayana · Dayana · Dayana · Dayana · Dayana ·</span></span>
      <div class="pass" data-pass>
        <span class="pass__clip" aria-hidden="true"></span>
        <header class="pass__top">
          <span class="pass__slot" aria-hidden="true"></span>
          <span class="pass__mark" aria-hidden="true"><img src="/sites/dayana/logo.svg" alt="" width="58" height="58" /></span>
          <span class="pass__who"><b>{BRAND.short}</b><small>Pase de entrada · {year}</small></span>
        </header>
        <div class="pass__body">
          <LoginForm formClass="lf" fieldClass="lf__field" labelClass="lf__label" inputClass="lf__input" toggleClass="lf__toggle" buttonClass="dy-btn lf__btn" noteClass="lf__note" buttonLabel="Entrar" delay={1400} error={error} />
        </div>
        <footer class="pass__foot" aria-hidden="true">
          <span class="pass__bars"></span>
          <span class="pass__no">N.º {String(year).slice(2)}-2010</span>
        </footer>
        <p class="pass__stamp" data-stamp aria-hidden="true">¡Adelante!</p>
      </div>
      <div class="gate__crew gate__crew--l" aria-hidden="true" data-crew><Crayon who="roja" pose="wave" face="grin" /></div>
      <div class="gate__crew gate__crew--r" aria-hidden="true" data-crew><Crayon who="azul" acc={['glasses']} flip /></div>
    </div>

    <a class="gate__back" href="/" data-gate-in>← Volver a la página</a>
  </section>
</Layout>

<script>
  import gsap from 'gsap'
  import { SplitText } from 'gsap/SplitText'
  import { mountHero } from './hero3d'
  import { confettiFrom } from './fx'

  gsap.registerPlugin(SplitText)
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches
  const wide = innerWidth > 860

  // The supplies frame the page; the middle stays clear for the copy and the pass.
  const canvas = document.querySelector<HTMLCanvasElement>('[data-desk]')
  const desk = canvas ? mountHero(canvas, {
    crew: [], count: wide ? 30 : 14, still: reduce,
    hole: (x, y, portrait) => portrait ? (y > -9 && y < 6 && Math.abs(x) < 5) : (x > -10.5 && x < 10.5 && y > -5.6 && y < 5.6),
  }) : null

  const pass = document.querySelector<HTMLElement>('[data-pass]')!
  const lanyard = document.querySelector<HTMLElement>('[data-lanyard]')!
  const stamp = document.querySelector<HTMLElement>('[data-stamp]')!
  const title = document.querySelector<HTMLElement>('[data-gate-title]')!
  const parts = document.querySelectorAll<HTMLElement>('[data-gate-in]')
  const crew = [...document.querySelectorAll<HTMLElement>('[data-crew]')]
  const scrib = document.querySelector<SVGPathElement>('.gate__scrib path')

  const intro = () => {
    desk?.reveal()
    if (reduce) { gsap.set([title, ...parts, lanyard, ...crew], { opacity: 1 }); return }
    const split = SplitText.create(title.querySelectorAll('.gate__l'), { type: 'chars', charsClass: 'ch' })
    gsap.set(title, { opacity: 1 })
    const tl = gsap.timeline()
    tl.from(split.chars, { yPercent: 115, rotate: () => gsap.utils.random(-18, 18), duration: 1.1, ease: 'expo.out', stagger: 0.04 })
    if (scrib) { const L = scrib.getTotalLength(); tl.fromTo(scrib, { strokeDasharray: L, strokeDashoffset: L }, { strokeDashoffset: 0, duration: 0.8, ease: 'power2.inOut' }, 0.5) }
    tl.fromTo(parts, { opacity: 0, y: 26 }, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out', stagger: 0.1 }, 0.4)
    // The pass drops on its strap and swings to rest; the crew pops up beside it.
    tl.fromTo(lanyard, { opacity: 1, yPercent: -140, rotate: 16 }, { yPercent: 0, duration: 1.1, ease: 'back.out(1.1)' }, 0.15)
      .to(lanyard, { rotate: 0, duration: 2.4, ease: 'elastic.out(1, 0.22)' }, 0.75)
      .fromTo(crew, { opacity: 1, y: 140, scale: 0.6 }, { y: 0, scale: 1, duration: 0.9, ease: 'back.out(2)', stagger: 0.15 }, 1.1)
  }
  type W = Window & { __dayanaReady?: boolean }
  if ((window as W).__dayanaReady) intro()
  else addEventListener('dayana:ready', intro, { once: true })

  // A pass on a strap: the pointer's sideways speed swings it, it settles back.
  if (fine && !reduce) {
    let lastX = 0, lastT = 0, settle = 0
    const swing = gsap.quickTo(lanyard, 'rotate', { duration: 1.6, ease: 'elastic.out(1, 0.25)' })
    const tiltX = gsap.quickTo(pass, 'rotateY', { duration: 0.6, ease: 'power3' })
    addEventListener('pointermove', e => {
      const now = performance.now()
      const v = lastT ? (e.clientX - lastX) / Math.max(8, now - lastT) : 0
      lastX = e.clientX; lastT = now
      swing(gsap.utils.clamp(-9, 9, v * 6))
      tiltX(((e.clientX / innerWidth) - 0.5) * 14)
      clearTimeout(settle)
      settle = window.setTimeout(() => swing(0), 120)
    }, { passive: true })
  }

  const hop = (el: Element | null) => { if (!el) return; el.classList.remove('cr-hop'); void (el as SVGElement).getBoundingClientRect(); el.classList.add('cr-hop') }

  // Wrong password: the pass shakes, the crew jumps.
  document.addEventListener('site:login-error', () => {
    if (reduce) return
    gsap.fromTo(pass, { x: 0 }, { keyframes: { x: [-18, 16, -12, 9, -5, 0] }, duration: 0.55, ease: 'power2.out' })
    gsap.fromTo(lanyard, { rotate: -5 }, { rotate: 0, duration: 1.4, ease: 'elastic.out(1, 0.25)' })
    crew.forEach(c => hop(c.querySelector('svg.cr')))
  })

  // In: stamp it, the crew cheers with confetti, then the pass flies up and the supplies rush past.
  document.addEventListener('site:login', () => {
    gsap.set(stamp, { opacity: 1 })
    crew.forEach(c => c.querySelector('svg.cr')?.classList.add('cr--cheer'))
    if (reduce) return
    confettiFrom(pass, 90)
    const tl = gsap.timeline()
    tl.fromTo(stamp, { scale: 2.6, rotate: -30, opacity: 0 }, { scale: 1, rotate: -14, opacity: 1, duration: 0.42, ease: 'back.out(2.2)' })
      .fromTo(pass, { scale: 1 }, { scale: 0.96, duration: 0.08, yoyo: true, repeat: 1 }, 0.36)
      .to(lanyard, { yPercent: -160, rotate: -10, duration: 0.7, ease: 'power3.in' }, 0.75)
      .to({ p: 0 }, { p: 1, duration: 1, ease: 'power2.in', onUpdate() { desk?.setProgress((this.targets()[0] as { p: number }).p) } }, 0.6)
      .to('.gate__copy', { opacity: 0, y: -30, duration: 0.5, ease: 'power2.in' }, 0.7)
  })
</script>

<style>
  .gate { position: relative; min-height: 100svh; background: var(--night); color: #fff; overflow: hidden; isolation: isolate;
    display: grid; grid-template-columns: 1.05fr 0.95fr; align-items: center; gap: clamp(24px, 4vw, 72px); padding: clamp(130px, 17vh, 170px) var(--m) clamp(80px, 10vh, 110px); }
  .gate__canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -1; }
  .gate__glow { position: absolute; inset: -20%; z-index: -2; background: radial-gradient(40% 50% at 22% 45%, #10399e 0%, transparent 70%), radial-gradient(35% 40% at 80% 60%, #6b0e2b 0%, transparent 70%), var(--night); }

  .gate__copy { position: relative; display: grid; gap: clamp(18px, 2vw, 28px); justify-items: start; }
  .gate__hand { font-size: clamp(1.7rem, 1.2rem + 1.2vw, 2.4rem); font-weight: 700; color: var(--yellow); line-height: 1; rotate: -3deg; }
  .gate__title { font-size: clamp(4.2rem, 1rem + 10vw, 11rem); font-weight: 900; line-height: 0.86; letter-spacing: -0.03em; display: grid; }
  :global(.d-js) .gate__title, :global(.d-js) [data-gate-in], :global(.d-js) .lanyard, :global(.d-js) [data-crew] { opacity: 0; }
  .gate__l { display: block; }
  .gate__l--2 { position: relative; justify-self: start; width: max-content; }
  .gate__l--2 em { font-style: normal; color: #ff4141; display: inline-block; }
  .gate__scrib { position: absolute; left: 0; right: 0; bottom: -0.08em; width: 100%; height: 0.2em; overflow: visible; }
  .gate__scrib path { fill: none; stroke: var(--yellow); stroke-width: 9; stroke-linecap: round; }
  .gate__sub { font-size: var(--step-lead); line-height: 1.35; max-width: 32ch; color: rgb(255 255 255 / 0.92); }
  .doors { display: flex; flex-wrap: wrap; gap: 12px; }
  .door { display: flex; align-items: center; gap: 12px; padding: 12px 18px 12px 12px; border-radius: 20px; background: var(--c); color: var(--i); border: 3px solid var(--ink); box-shadow: 0 6px 0 rgb(0 0 0 / 0.45); }
  .door svg { width: 40px; height: 40px; padding: 6px; border-radius: 12px; background: var(--paper); flex-shrink: 0; }
  .door span { display: grid; font-size: 0.9375rem; font-weight: 500; line-height: 1.25; }
  .door b { font-size: 1.125rem; font-weight: 800; }
  .gate__back { position: absolute; left: var(--m); bottom: 26px; color: rgb(255 255 255 / 0.85); font-weight: 700; text-decoration: none; }
  @media (hover: hover) { .gate__back:hover { color: var(--yellow); } }

  /* ── The pass on its lanyard ── */
  .lanyard { position: relative; justify-self: center; width: min(440px, 100%); transform-origin: 50% -60vh; perspective: 1200px; }
  .strap { position: absolute; left: 50%; bottom: calc(100% - 18px); width: 34px; height: 70vh; translate: -50% 0; background: var(--red); overflow: hidden; display: grid; place-items: end center; box-shadow: inset 6px 0 0 rgb(0 0 0 / 0.12), inset -6px 0 0 rgb(0 0 0 / 0.12); }
  .strap span { writing-mode: vertical-rl; transform: rotate(180deg); white-space: nowrap; font-weight: 800; font-size: 0.8125rem; letter-spacing: 0.14em; text-transform: uppercase; color: #fff; padding-block: 16px; }
  .pass { position: relative; z-index: 2; background: var(--paper); color: var(--ink); border: 3px solid var(--ink); border-radius: 30px; box-shadow: 0 18px 0 var(--ink), 0 40px 80px -30px rgb(0 0 0 / 0.7); transform-style: preserve-3d; }
  .pass__clip { position: absolute; left: 50%; top: -30px; width: 64px; height: 44px; translate: -50% 0; border-radius: 12px; background: #c9ccd6; border: 3px solid var(--ink); z-index: 2; }
  .pass__clip::after { content: ''; position: absolute; left: 50%; bottom: 8px; width: 26px; height: 10px; translate: -50% 0; border-radius: 6px; background: var(--ink); }
  .pass__top { position: relative; display: flex; align-items: center; gap: 14px; padding: 34px 26px 22px; background: var(--yellow); border-radius: 27px 27px 0 0; border-bottom: 3px solid var(--ink); }
  .pass__slot { position: absolute; left: 50%; top: 12px; width: 70px; height: 12px; translate: -50% 0; border-radius: 8px; background: var(--ink); }
  .pass__mark { width: 62px; height: 62px; border-radius: 50%; background: #fff; display: grid; place-items: center; flex-shrink: 0; rotate: -6deg; border: 3px solid var(--ink); padding: 3px; }
  .pass__who { display: grid; line-height: 1; gap: 6px; }
  .pass__who b { font: 900 clamp(2rem, 1.5rem + 1.4vw, 2.8rem)/1 var(--display); font-variation-settings: var(--soft); letter-spacing: -0.03em; color: var(--red); }
  .pass__who small { font-size: 0.8125rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.12em; }
  .pass__body { padding: 26px; }
  .pass__foot { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 0 26px 24px; }
  .pass__bars { flex: 1; max-width: 190px; height: 34px; background: repeating-linear-gradient(90deg, var(--ink) 0 3px, transparent 3px 5px, var(--ink) 5px 6px, transparent 6px 9px, var(--ink) 9px 13px, transparent 13px 15px); }
  .pass__no { font-weight: 800; font-variant-numeric: tabular-nums; letter-spacing: 0.06em; }
  .pass__stamp { position: absolute; left: 50%; top: 52%; translate: -50% -50%; rotate: -14deg; opacity: 0; pointer-events: none; z-index: 3;
    padding: 10px 26px; border: 6px solid var(--green); border-radius: 18px; color: var(--green); background: rgb(255 248 236 / 0.9);
    font: 900 clamp(2.6rem, 2rem + 2vw, 3.6rem)/1 var(--display); font-variation-settings: var(--soft); text-transform: uppercase; white-space: nowrap; }
  .gate__crew { position: absolute; bottom: -18px; width: clamp(96px, 9vw, 130px); z-index: 3; }
  .gate__crew--l { left: -18%; }
  .gate__crew--r { right: -15%; bottom: 40%; width: clamp(80px, 7vw, 108px); z-index: 1; }
  .gate__crew > :global(svg) { --line: #fff; }

  /* The shared login form, in the pass's style. */
  .pass :global(.lf) { display: grid; gap: 16px; }
  .pass :global(.lf__field) { display: grid; gap: 6px; position: relative; }
  .pass :global(.lf__label) { font-size: 0.875rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.08em; }
  .pass :global(.lf__input) { width: 100%; height: 60px; border: 3px solid var(--ink); border-radius: 18px; padding: 0 18px; background: #fff; color: var(--ink); font: 600 1.125rem var(--font); transition: box-shadow 200ms var(--ease-out), transform 200ms var(--ease-out); }
  .pass :global(.lf__input::placeholder) { color: #8a86a0; font-weight: 500; }
  .pass :global(.lf__input:focus) { outline: none; border-color: var(--navy); box-shadow: 0 6px 0 var(--sky); transform: translateY(-2px); }
  .pass :global(.lf__toggle) { position: absolute; right: 10px; bottom: 10px; height: 40px; padding: 0 14px; border: 0; border-radius: 12px; background: var(--ink); color: var(--paper); font: 800 0.875rem var(--font); cursor: pointer; }
  .pass :global(.lf__btn) { width: 100%; height: 64px; font-size: 1.1875rem; margin-top: 4px; }
  .pass :global(.lf__btn:disabled) { cursor: progress; }
  .pass :global(.lf__note) { font-size: 0.9375rem; line-height: 1.4; color: var(--muted); min-height: 2.8em; }
  .pass :global(.lf[data-state='error'] .lf__note) { color: var(--red-deep); font-weight: 700; }
  .pass :global(.lf[data-state='ok'] .lf__note) { color: var(--green); font-weight: 800; }

  @media (max-width: 860px) {
    .gate { grid-template-columns: 1fr; align-items: start; padding-top: 110px; padding-bottom: 90px; gap: 80px; }
    .gate__title { font-size: clamp(3.6rem, 1rem + 13vw, 6rem); }
    .lanyard { transform-origin: 50% -66px; }
    .strap { height: 84px; }
    .gate__crew--l { left: -4px; bottom: -64px; width: 84px; }
    .gate__crew--r { right: -4px; bottom: auto; top: -96px; width: 70px; }
  }
  @media (max-width: 420px) { .pass__top { padding-inline: 18px; } .pass__body { padding: 20px 18px; } .pass__foot { padding-inline: 18px; } }
</style>
