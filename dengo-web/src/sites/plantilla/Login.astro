---
// "Ingresar" in the template: a brand panel that says who can come in, and
// the shared login form on a card.
import Layout from './Layout.astro'
import LoginForm from '../../core/LoginForm.astro'
import type { SiteContent } from '../../core/types'
const { content, error } = Astro.props as { content: SiteContent; error?: string | null }
const teachers = !!content.access?.teachers
const staff = !!content.access?.staff
---
<Layout content={content} title="Ingresar" noindex bar={false}>
  <section class="in">
    <div class="wrap in__grid">
      <div class="in__panel" data-reveal>
        <h1 class="display in__title">Bienvenido de vuelta</h1>
        <p class="lead">Inicia sesión con tu correo. Según tu usuario, te llevamos directo a donde te toca.</p>
        <ul class="in__doors">
          {staff && <li><b>Equipo de {content.businessName}</b><span>Caja, inventario y reportes</span></li>}
          {teachers && <li><b>Maestros</b><span>Pedidos de útiles, valija didáctica y gratuidad</span></li>}
        </ul>
      </div>
      <div class="in__card" data-reveal style="--i:1">
        <h2 class="in__h2">Iniciar sesión</h2>
        <LoginForm formClass="lf" fieldClass="lf__field" labelClass="lf__label" inputClass="lf__input" toggleClass="lf__toggle" buttonClass="btn lf__btn" noteClass="lf__note" buttonLabel="Entrar" delay={350} error={error ?? null} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .in { padding-block: clamp(36px, 6vw, 96px); background: var(--brand-tint); min-height: calc(100svh - 76px); display: grid; align-items: center; }
  .in__grid { display: grid; grid-template-columns: 1fr minmax(320px, 460px); gap: clamp(24px, 6vw, 96px); align-items: center; }
  .in__panel { display: grid; gap: 20px; }
  .in__title { font-size: var(--step-hero); max-width: 11ch; }
  .in__doors { list-style: none; margin: 8px 0 0; padding: 0; display: grid; gap: 10px; max-width: 460px; }
  .in__doors li { display: grid; gap: 2px; padding: 16px 18px; border-radius: var(--radius); background: var(--card); box-shadow: var(--shadow); border-left: 5px solid var(--brand-2); }
  :global([data-theme='editorial']) .in__doors li { box-shadow: inset 0 0 0 1px var(--ink); border-left-width: 5px; }
  .in__doors b { font-size: 1.0625rem; }
  .in__doors span { color: var(--soft); font-size: 0.9375rem; }
  .in__card { background: var(--card); border-radius: var(--radius-lg); padding: clamp(24px, 3.4vw, 40px); box-shadow: var(--shadow-lg); background-image: linear-gradient(var(--brand), var(--brand)); background-size: 100% 6px; background-repeat: no-repeat; }
  :global([data-theme='editorial']) .in__card { box-shadow: inset 0 0 0 1.5px var(--ink); }
  .in__h2 { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(1.75rem, 1.4rem + 1vw, 2.25rem); margin: 0 0 20px; }
  .in :global(.lf) { display: grid; gap: 16px; }
  .in :global(.lf.is-shake) { animation: shake 450ms var(--ease-out); }
  @keyframes shake { 20% { transform: translateX(-10px); } 40% { transform: translateX(8px); } 60% { transform: translateX(-5px); } 80% { transform: translateX(3px); } }
  @media (prefers-reduced-motion: reduce) { .in :global(.lf.is-shake) { animation: none; } }
  .in :global(.lf__field) { display: grid; gap: 6px; }
  .in :global(.lf__label) { font-size: 0.875rem; font-weight: 600; }
  .in :global(.lf__input) { width: 100%; min-height: 54px; padding: 0 16px; border: 1.5px solid var(--line); border-radius: var(--btn-radius); background: var(--ground); color: var(--ink); font: inherit; transition: border-color 160ms ease, box-shadow 160ms ease; }
  .in :global(.lf__input:focus) { outline: none; border-color: var(--brand); box-shadow: 0 0 0 4px color-mix(in oklab, var(--brand) 18%, transparent); }
  .in :global(.lf__toggle) { position: absolute; right: 8px; top: 50%; translate: 0 -50%; height: 38px; padding: 0 12px; border: 0; border-radius: calc(var(--btn-radius) * 0.8); background: var(--surface); color: var(--ink); font: 600 0.875rem var(--font-text); cursor: pointer; }
  .in :global(.lf__btn) { width: 100%; min-height: 56px; font-size: 1.0625rem; margin-top: 4px; }
  .in :global(.lf__btn:disabled) { opacity: 0.75; cursor: progress; }
  .in :global(.lf__note) { font-size: 0.9375rem; color: var(--soft); min-height: 2.8em; }
  .in :global(.lf[data-state='error'] .lf__note) { color: #b42318; font-weight: 600; }
  .in :global(.lf[data-state='ok'] .lf__note) { color: #146c3c; font-weight: 700; }
  @media (max-width: 860px) { .in__grid { grid-template-columns: 1fr; } }
</style>
