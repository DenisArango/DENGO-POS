---
import Layout from './Layout.astro'
import type { SiteContent } from '../../core/types'
const { content } = Astro.props as { content: SiteContent }
---
<Layout content={content} title="Página no encontrada" noindex bar={false}>
  <section class="nf">
    <div class="wrap nf__in">
      <p class="display nf__num" aria-hidden="true">404</p>
      <h1 class="display nf__title">No encontramos esta página</h1>
      <p class="lead soft">Puede que el enlace esté mal escrito o que la página ya no exista.</p>
      <p class="nf__actions">
        <a class="btn" href="/">Ir al inicio</a>
        {content.promotions.length > 0 && <a class="btn btn--ghost" href="/ofertas">Ver ofertas</a>}
      </p>
    </div>
  </section>
</Layout>

<style>
  .nf { min-height: calc(100svh - 76px); display: grid; align-items: center; padding-block: 64px; }
  .nf__in { display: grid; gap: 18px; justify-items: start; }
  .nf__num { font-size: clamp(7rem, 4rem + 14vw, 16rem); line-height: 0.8; color: var(--brand); }
  .nf__num::first-letter { color: var(--brand-2); }
  .nf__title { font-size: var(--step-head); }
  .nf__actions { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 8px; }
</style>
