---
import Layout from './Layout.astro'
import CouponForm from '../../core/CouponForm.astro'
import { offerHeadline, fmtDay, money } from '../../core/api'
import type { Promotion, SiteContent } from '../../core/types'
const { content, promotion: o, formError } = Astro.props as { content: SiteContent; promotion: Promotion; formError?: string | null }
const ended = o.live === false || (o.couponsLeft !== null && o.couponsLeft <= 0)
const facts = [
  o.endsAt && ['Válida hasta', fmtDay(o.endsAt)],
  o.minPurchase && ['Compra mínima', money(o.minPurchase)],
  o.couponsLeft !== null && ['Cupones disponibles', String(o.couponsLeft)],
].filter(Boolean) as [string, string][]
---
<Layout content={content} title={o.name} description={`${o.summary}. ${o.description ?? ''}`.trim()} bar={false}>
  <section class="section offer">
    <div class="wrap">
      <a class="crumb" href="/ofertas">← Todas las ofertas</a>
      <div class="offer__grid">
        <article class="offer__card" data-reveal>
          <div class="offer__stub">
            <span class="offer__value">{offerHeadline(o)}</span>
            <span class="offer__biz">{content.businessName}</span>
          </div>
          <div class="offer__info">
            <h1 class="display offer__title">{o.name}</h1>
            <p class="lead">{o.summary}</p>
            {o.description && <p class="offer__desc">{o.description}</p>}
            {facts.length > 0 && (
              <dl class="offer__facts">
                {facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
              </dl>
            )}
            {o.image && <img class="offer__img" src={o.image} alt="" width="900" height="600" loading="lazy" />}
          </div>
        </article>
        <aside class="offer__side" data-reveal style="--i:1">
          {ended ? (
            <div class="offer__form">
              <h2 class="offer__h2">Esta oferta ya terminó</h2>
              <p class="soft">Hay nuevas cada temporada.</p>
              <a class="btn" href="/ofertas">Ver las ofertas vigentes</a>
            </div>
          ) : (
            <div class="offer__form">
              <h2 class="offer__h2">Obtén tu cupón</h2>
              <p class="soft offer__hint">Te damos un código único para presentar en caja.</p>
              {formError && <p class="offer__error" role="alert">{formError}</p>}
              <CouponForm slug={o.slug} formClass="cf" inputClass="cf__input" buttonClass="btn btn--accent cf__btn" noteClass="cf__note" />
            </div>
          )}
          {o.terms && <p class="offer__terms">{o.terms}</p>}
        </aside>
      </div>
    </div>
  </section>
</Layout>

<style>
  .offer { padding-top: clamp(28px, 4vw, 56px); }
  .offer .crumb { color: var(--soft); }
  .offer__grid { display: grid; grid-template-columns: 1.2fr 0.8fr; gap: clamp(20px, 4vw, 56px); align-items: start; }
  .offer__card { display: grid; grid-template-columns: minmax(150px, 0.42fr) 1fr; background: var(--card); border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  :global([data-theme='editorial']) .offer__card { box-shadow: inset 0 0 0 1.5px var(--ink); }
  .offer__stub { display: grid; align-content: space-between; gap: 24px; padding: clamp(22px, 3vw, 40px); background: var(--brand); color: var(--on-brand); border-right: 3px dashed color-mix(in oklab, var(--on-brand) 40%, transparent); }
  .offer__stub { container-type: inline-size; }
  /* sized to the stub's width so "Q149" or "15%" never breaks in two */
  .offer__value { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(2.5rem, 32cqi, 7rem); line-height: 0.9; font-variant-numeric: tabular-nums; white-space: nowrap; }
  :global([data-theme='editorial']) .offer__value { font-size: clamp(2.5rem, 46cqi, 8rem); }
  .offer__biz { font-weight: 600; font-size: 0.9375rem; opacity: 0.85; }
  .offer__info { display: grid; gap: 14px; align-content: start; padding: clamp(22px, 3.4vw, 48px); }
  .offer__title { font-size: var(--step-head); }
  .offer__desc { color: var(--soft); }
  .offer__facts { display: grid; grid-template-columns: repeat(auto-fit, minmax(140px, 1fr)); gap: 10px; margin: 6px 0 0; }
  .offer__facts div { background: var(--brand-tint); padding: 12px 14px; border-radius: var(--radius); }
  .offer__facts dt { font-size: var(--step-small); color: var(--soft); }
  .offer__facts dd { margin: 2px 0 0; font-weight: 650; font-size: 1.125rem; }
  .offer__img { margin-top: 10px; width: 100%; aspect-ratio: 3 / 2; object-fit: cover; border-radius: var(--radius); }
  .offer__side { position: sticky; top: 100px; display: grid; gap: 16px; }
  .offer__form { display: grid; gap: 12px; background: var(--card); padding: clamp(22px, 3vw, 36px); border-radius: var(--radius-lg); box-shadow: var(--shadow-lg); background-image: linear-gradient(var(--brand-2), var(--brand-2)); background-size: 100% 6px; background-repeat: no-repeat; }
  :global([data-theme='editorial']) .offer__form { box-shadow: inset 0 0 0 1.5px var(--ink); }
  .offer__h2 { font-family: var(--font-display); font-weight: var(--display-weight); letter-spacing: var(--display-track); font-size: clamp(1.75rem, 1.3rem + 1.4vw, 2.5rem); line-height: 1.05; margin: 0; }
  .offer__hint { margin-bottom: 6px; }
  .offer__error { font-weight: 600; color: #b42318; background: #fde8e6; padding: 10px 14px; border-radius: var(--radius); }
  .offer__terms { font-size: var(--step-small); color: var(--soft); padding-inline: 4px; }
  .offer :global(.cf) { display: grid; gap: 10px; }
  .offer :global(.cf__input) { min-height: 56px; padding: 0 16px; border: 1.5px solid var(--line); border-radius: var(--btn-radius); background: var(--ground); color: var(--ink); font: inherit; transition: border-color 160ms ease, box-shadow 160ms ease; }
  .offer :global(.cf__input:focus) { outline: none; border-color: var(--brand); box-shadow: 0 0 0 4px color-mix(in oklab, var(--brand) 18%, transparent); }
  .offer :global(.cf__btn) { min-height: 58px; width: 100%; font-size: 1.0625rem; margin-top: 4px; }
  .offer :global(.cf__btn:disabled) { opacity: 0.7; cursor: progress; }
  .offer :global(.cf__note) { margin: 4px 0 0; font-size: var(--step-small); color: var(--soft); }
  @media (max-width: 960px) { .offer__grid { grid-template-columns: 1fr; } .offer__side { position: static; } }
  @media (max-width: 600px) { .offer__card { grid-template-columns: 1fr; } .offer__stub { border-right: 0; border-bottom: 3px dashed color-mix(in oklab, var(--on-brand) 40%, transparent); } }
</style>
