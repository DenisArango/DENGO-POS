---
import Layout from './Layout.astro'
import OffersBlock from '../../blocks/Offers.astro'
import { waLink } from '../../core/api'
import type { SiteContent } from '../../core/types'
const { content } = Astro.props as { content: SiteContent }
const block = content.sections.find(s => s.type === 'offers') ?? { id: 'offers', type: 'offers' as const, enabled: true, props: {} }
const n = content.promotions.length
const wa = waLink(content.contact.whatsapp, `Hola ${content.businessName}, ¿qué ofertas tienen esta semana?`)
---
<Layout content={content} title="Ofertas" description={`Ofertas vigentes de ${content.businessName}. Obtén tu cupón y preséntalo en caja.`} bar={false}>
  <header class="phead">
    <div class="wrap">
      <a class="crumb" href="/">← Inicio</a>
      <h1 class="display phead__title" data-reveal>{n ? 'Ofertas vigentes' : 'Ofertas'}</h1>
      <p class="lead" data-reveal style="--i:1">
        {n ? `${n} ${n === 1 ? 'oferta' : 'ofertas'} con cupón en línea. Pide el tuyo, preséntalo en caja y el descuento se aplica al momento.` : 'Por ahora no hay ofertas vigentes. Vuelve pronto o escríbenos para enterarte primero.'}
      </p>
    </div>
  </header>
  {n > 0 ? (
    <>
      <OffersBlock block={block} promotions={content.promotions} full heading={false} />
      <section class="section how">
        <div class="wrap">
          <h2 class="display h-section h-mark" data-reveal>Cómo funciona</h2>
          <ol class="how__list">
            <li data-reveal style="--i:1"><b>1</b><span><strong>Elige tu oferta</strong>Deja tu nombre y tu teléfono. Sin cuentas ni contraseñas.</span></li>
            <li data-reveal style="--i:2"><b>2</b><span><strong>Recibe tu cupón</strong>Con un código QR único, solo para ti.</span></li>
            <li data-reveal style="--i:3"><b>3</b><span><strong>Preséntalo en caja</strong>Lo escanean y el descuento se aplica. Se usa una vez.</span></li>
          </ol>
        </div>
      </section>
    </>
  ) : wa && (
    <section class="section"><div class="wrap"><a class="btn btn--wa" href={wa} target="_blank" rel="noopener">Pregúntanos por WhatsApp</a></div></section>
  )}
</Layout>

<style>
  .how { background: var(--surface); }
  .how__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: clamp(14px, 2vw, 24px); counter-reset: s; }
  .how__list li { display: flex; gap: 16px; align-items: flex-start; padding: clamp(20px, 2.4vw, 30px); background: var(--card); border-radius: var(--radius-lg); box-shadow: var(--shadow); }
  :global([data-theme='editorial']) .how__list li { box-shadow: inset 0 0 0 1px var(--ink); }
  .how__list b { flex-shrink: 0; width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; background: var(--brand); color: var(--on-brand); font-family: var(--font-display); font-size: 1.5rem; }
  .how__list span { display: grid; gap: 4px; color: var(--soft); }
  .how__list strong { color: var(--ink); font-size: 1.1875rem; }
  @media (max-width: 860px) { .how__list { grid-template-columns: 1fr; } }
</style>
