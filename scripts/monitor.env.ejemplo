# Copia este archivo a ~/dengo/monitor.env y llena los dos datos de Telegram.
# (Cómo obtenerlos: ver el encabezado de monitor-servidor.mjs o las instrucciones de instalación.)

TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Nombre que sale en los avisos (por defecto, el hostname)
NOMBRE_SERVIDOR=dengo-server

# Límites — avisa al pasarlos
MEMORIA_PROCESO_MB=1200        # memoria de UN proceso de pm2
RAM_DISPONIBLE_MIN_PCT=20      # RAM disponible del servidor, en %
DISCO_MAX_PCT=85               # uso del disco, en %
CARGA_MAX_POR_CPU=1.5          # load average de 5 min dividido entre núcleos
HEALTH_LENTO_MS=3000           # /api/health tardando más que esto
REPETIR_MIN=30                 # cada cuánto recordar un problema que sigue
